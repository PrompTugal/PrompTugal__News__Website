<!-- C, the top of every page, and since 10 November E's masthead (part emast: Dinis 14:35, The Front Page as the whole site's theme; designer@'s board/spec-the-front-page-theme.md T1 to T3): the component's markup, filled by newsroom/build/lib/top.mjs ({{name}} is a value,
     {{#name}} a list made from the matching item below). The look: top.css; the switch and More: top.js. -->
<!-- part:head -->
<header class="ctop">
<div class="ctop-row">
<a class="ctop-home" href="{{up}}index.html" aria-label="{{name}}, the front page"><img class="ctop-stamp tone-light" src="{{up}}assets/brand/pt-news-stamp-light.svg" alt="" width="40" height="40"><img class="ctop-stamp tone-dark" src="{{up}}assets/brand/pt-news-stamp-dark.svg" alt="" width="40" height="40"><span class="ctop-name"><b>{{name}}</b><time datetime="{{today}}">{{date}}</time></span><span class="ctop-wm">{{wordmark}}</span></a>
<form class="ctop-search" role="search" action="{{up}}search/index.html" method="get"><label for="ctop-q"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/></svg><span class="visually-hidden">Search</span></label><input id="ctop-q" name="q" type="search" placeholder="Search companies, people, events" autocomplete="off"><kbd>/</kbd></form>
<p class="ctop-when"><span><time datetime="{{today}}">{{date}}</time>{{go}}</span><span>{{#util}}</span></p>
</div>
<nav class="ctop-nav" aria-label="Sections"><div class="links">{{#nav}}</div><p class="ctop-motto">{{motto}}.</p></nav>
</header>
<p class="ctop-tagline">{{motto}}.</p>
<!-- part:emast -->
<header class="emast" aria-label="{{name}}">
<div class="em-w"><div class="em-dl"><time datetime="{{today}}"><span class="em-long">{{longdate}}</span><span class="em-short">{{shortdate}}</span></time><span class="em-where">Lisbon · Independent</span><span class="em-tools"><a class="em-pill" href="{{up}}search/index.html"{{search_cur}} data-nav="search">Search</a><button type="button" class="em-pill em-lang" aria-haspopup="true" aria-expanded="false" aria-label="Language" hidden><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><span>EN</span></button><span class="ctop-tools"></span></span></div>
<a class="em-mark" href="{{up}}index.html" aria-label="{{name}}, the front page">{{wordmark}}</a>
<nav class="em-nav" aria-label="Sections">{{#nav}}</nav></div>
</header>
<!-- part:tabs -->
<nav class="ctabs" aria-label="Sections, at the bottom">{{#tabs}}<a href="{{up}}search/index.html"{{search_cur}}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/></svg><span>Search</span></a><button type="button" class="ctabs-more" aria-expanded="false" aria-controls="ctop-more"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span>More</span></button></nav>
<div class="cmore" id="ctop-more" hidden><nav aria-label="Every section">{{#all}}</nav></div>
<!-- item:link --><a href="{{href}}"{{cur}} data-nav="{{id}}">{{label}}</a>
<!-- item:go --> · <b>{{text}}</b>
<!-- item:tab-now --><a href="{{href}}"{{cur}} data-nav="now"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{{label}}</span></a>
<!-- item:tab-agenda --><a href="{{href}}"{{cur}} data-nav="agenda"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="5" width="16" height="15" rx="1"/><path d="M4 10h16M9 3v4M15 3v4"/></svg><span>{{label}}</span></a>
<!-- item:tab-news --><a href="{{href}}"{{cur}} data-nav="news"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="5" y="4" width="14" height="16" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><span>{{label}}</span></a>
<!-- item:tab-companies --><a href="{{href}}"{{cur}} data-nav="companies"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V10h6v10M10 20V5h6v15M16 20v-7h4v7M3 20h18"/></svg><span>{{label}}</span></a>
<!-- end -->
