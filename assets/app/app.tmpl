<!-- The news app on the web (Dinis, 9 November 2026, about 14:40 UTC; board/briefs/2026-11-09-the-app-on-the-web.md):
     the summit's programme as an app, in the browser, with no store in the way. Step 1: the schedule, picks, clashes,
     free time and Add to Calendar (.ics). Picks are the site's own ("Add to my day", localStorage nr.schedule.v1), so the
     app, /my-day/ and the agenda agree. Nothing leaves the browser. Markup and words; filled by
     newsroom/build/features/app.mjs ({{up}} is the way back to the site's root); behaviour: assets/app/app.js. -->
<!-- part:page -->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The app · PrompTugal.news</title>
<meta name="description" content="{{summary}}">
<meta name="theme-color" content="#121317">
<link rel="icon" href="{{up}}assets/brand/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="{{up}}assets/app/manifest.webmanifest">
<link rel="apple-touch-icon" href="{{up}}assets/brand/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="PT app">
<link rel="stylesheet" href="{{up}}assets/fonts.css">
<link rel="stylesheet" href="{{up}}assets/app/app.css">
<script defer src="{{up}}assets/app/app.js"></script>
</head>
<body>
<div class="pa" id="pt-app" data-up="{{up}}">
<header class="pa-top">
<a class="pa-home" href="{{up}}index.html" target="_top"><img src="{{up}}assets/brand/pt-news-stamp-dark.svg" alt="" width="32" height="32"><b>PrompTugal.news</b></a>
<span class="pa-sub"><span data-t="sub">Web Summit Lisbon</span><span class="pa-sub-long" data-t="sub_long">, 9 to 12 November</span></span>
<button type="button" class="pa-lang" aria-haspopup="true" aria-expanded="false" data-t-aria="lang_label" aria-label="Language"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><span class="pa-lang-id">EN</span></button>
<a class="pa-act pa-full" href="{{up}}app/index.html" target="_blank" rel="noopener" hidden data-t="full">Full screen</a>
<button type="button" class="pa-act pa-install" hidden data-t="install">Install</button>
<a class="pa-act pa-news" href="{{up}}index.html" hidden data-t="news">News</a>
</header>
<div class="pa-sheet" role="dialog" data-t-aria="sheet_label" aria-label="Install the app" hidden><p><span data-t="sheet_a">Tap</span> <svg viewBox="0 0 24 24" width="18" height="18" aria-label="Share"><path d="M12 3v12M7 8l5-5 5 5M5 12v8h14v-8" fill="none" stroke="currentColor" stroke-width="2"/></svg> <span data-t="sheet_b">Share, then</span> <b data-t="sheet_c">Add to Home Screen</b></p><button type="button" data-ok data-t="ok">OK</button></div>
<div class="pa-langs" role="menu" hidden></div>
<nav class="pa-days" aria-label="Days" data-t-aria="days_label"></nav>
<div class="pa-tabs" role="group" aria-label="View" data-t-aria="view_label"><button type="button" data-tab="all" data-t="tab_all">Programme</button><button type="button" data-tab="mine" data-t="tab_mine">My picks</button></div>
<input class="pa-q" type="search" placeholder="Search a session, a company, a stage" aria-label="Search the programme" data-t-ph="q_ph" data-t-aria="q_label">
<section class="pa-next" hidden aria-label="Where I need to be next" data-t-aria="next_label"><p class="pa-next-k"></p><p class="pa-next-t"></p><p class="pa-next-w"></p><p class="pa-next-go"><a class="pa-dir" target="_blank" rel="noopener" data-t="dir">Directions</a> <a class="pa-map" href="{{up}}summit/venue/index.html" target="_top" data-t="map">On the venue map</a></p></section>
<main class="pa-list" aria-live="polite"><p class="pa-note" data-t="loading">Loading the programme…</p></main>
<footer class="pa-foot">
<p><button type="button" class="pa-ics-all" hidden data-t="ics_all">Add all my picks to my calendar</button></p>
<p class="pa-small"><span data-t="privacy">Your picks stay in this browser; this site never receives them. Times are Lisbon time and can change: check the summit's own schedule.</span> <span class="pa-mt" hidden></span> <a href="{{up}}my-day/index.html" target="_top" data-t="my_day">My day</a> · <a href="{{up}}events/index.html" target="_top" data-t="agenda">The agenda</a></p>
</footer>
</div>
<script type="application/json" id="pa-i18n">{{i18n}}</script>
</body>
</html>
<!-- end -->
