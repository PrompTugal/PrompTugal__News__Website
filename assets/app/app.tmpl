<!-- The news app on the web (Dinis, 9 November 2026, about 14:40 UTC; board/briefs/2026-11-09-the-app-on-the-web.md):
     the summit's programme as an app, in the browser, with no store in the way. Step 1: the schedule, picks, clashes,
     free time and Add to Calendar (.ics). Picks are the site's own ("Add to my day", localStorage nr.schedule.v1), so the
     app, /my-day/ and the agenda agree. Nothing leaves the browser. Markup and words; filled by
     newsroom/build/features/app.mjs ({{up}} is the way back to the site's root); behaviour: assets/app/app.js. -->
<!-- part:page -->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The app · PrompTugal.news</title>
<meta name="description" content="{{summary}}">
<meta name="theme-color" content="#121317">
<link rel="icon" href="{{up}}assets/brand/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="{{up}}assets/app/manifest.webmanifest">
<link rel="apple-touch-icon" href="{{up}}assets/brand/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="PT app">
<link rel="stylesheet" href="{{up}}assets/fonts.css">
<link rel="stylesheet" href="{{up}}assets/app/app.css">
<script defer src="{{up}}assets/app/app.js"></script>
</head>
<body>
<div class="pa" id="pt-app" data-up="{{up}}">
<header class="pa-top">
<a class="pa-home" href="{{up}}index.html" target="_top"><img src="{{up}}assets/brand/pt-news-stamp-dark.svg" alt="" width="32" height="32"><b>PrompTugal.news</b></a>
<span class="pa-sub"><span>Web Summit Lisbon</span><span class="pa-sub-long">, 9 to 12 November</span></span>
<a class="pa-act pa-full" href="{{up}}app/index.html" target="_blank" rel="noopener" hidden>Full screen</a>
<button type="button" class="pa-act pa-install" hidden>Install</button>
<a class="pa-act pa-news" href="{{up}}index.html" hidden>News</a>
</header>
<div class="pa-sheet" role="dialog" aria-label="Install the app" hidden><p>Tap <svg viewBox="0 0 24 24" width="18" height="18" aria-label="Share"><path d="M12 3v12M7 8l5-5 5 5M5 12v8h14v-8" fill="none" stroke="currentColor" stroke-width="2"/></svg> Share, then <b>Add to Home Screen</b>.</p><button type="button" data-ok>OK</button></div>
<nav class="pa-days" aria-label="Days"></nav>
<div class="pa-tabs" role="group" aria-label="View"><button type="button" data-tab="all">Programme</button><button type="button" data-tab="mine">My picks</button></div>
<input class="pa-q" type="search" placeholder="Search a session, a company, a stage" aria-label="Search the programme">
<section class="pa-next" hidden aria-label="Where I need to be next"><p class="pa-next-k"></p><p class="pa-next-t"></p><p class="pa-next-w"></p><p class="pa-next-go"><a class="pa-dir" target="_blank" rel="noopener">Directions</a> <a class="pa-map" href="{{up}}summit/venue/index.html" target="_top">On the venue map</a></p></section>
<main class="pa-list" aria-live="polite"><p class="pa-note">Loading the programme…</p></main>
<footer class="pa-foot">
<p><button type="button" class="pa-ics-all" hidden>Add all my picks to my calendar</button></p>
<p class="pa-small">Your picks stay in this browser; this site never receives them. Times are Lisbon time and can change: check the summit's own schedule. <a href="{{up}}my-day/index.html" target="_top">My day</a> · <a href="{{up}}events/index.html" target="_top">The agenda</a></p>
</footer>
</div>
<script type="application/json" id="pa-words">{"pick":"Add","picked":"Added","clash":"Clashes with","free":"Free","ics":"Calendar","none_mine":"No picks on this day yet. Add sessions from the programme.","none":"Nothing matches on this day.","failed":"The programme did not load. Try again when you are online.","until":"until","all_day":"All day","next_now":"Now","next_in":"Next, in","next_min":"min","next_h":"h","day_n":"Day","back":"Back to the site"}</script>
</body>
</html>
<!-- end -->
