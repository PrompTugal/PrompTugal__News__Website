<!-- Each place's newsroom, end to end. Filled by newsroom/build/features/viz-newsroom.mjs; values arrive escaped. Sections start with a comment line of their name. -->
<!-- stations -->
<div class="vz-stations" style="--c:{{accent}}">{{items}}</div>
<!-- station -->
<section class="vz-st vz-st-{{id}}"><p class="vz-st-step">{{n}} · {{label}}</p><div class="vz-st-fig">{{fig}}</div><p class="vz-st-who">{{who}}</p><p class="vz-st-big"><strong>{{big}}</strong> {{unit}}</p><ul class="vz-st-lines">{{lines}}</ul></section>
<!-- line -->
<li>{{t}}</li>
<!-- box -->
<span class="vz-st-box">{{t}}</span>
<!-- chart -->
<figure class="vz-chart"><svg viewBox="0 0 {{w}} {{h}}" width="100%" role="img" aria-label="{{aria}}"><title>{{aria}}</title>{{body}}</svg><figcaption>{{legend}}</figcaption></figure>
<!-- key -->
<span class="vz-key-sw"><i style="background:{{c}}"></i>{{t}}</span>
<!-- run -->
<ol class="vz-run">{{rows}}</ol>
<!-- run-row -->
<li class="vz-run-row"><span class="vz-run-t">{{t}}</span><span class="vz-run-head">{{head}}</span><span class="vz-run-what"><b>{{who}}</b> <a href="{{href}}" target="_blank" rel="noopener">{{subject}}</a> <span class="vz-run-delta">{{delta}}</span></span><span class="vz-run-rel">{{rel}}</span></li>
<!-- hero -->
<div class="vz-nr-hero" style="--c:{{accent}}"><div class="vz-nr-heads">{{heads}}</div><p class="vz-nr-lede">{{lede}}</p><p class="vz-nr-links"><a href="{{place}}">the page it makes</a> · <a href="{{agents}}">the agents</a> · <a href="{{explainer}}">how the whole system works</a> · <span class="vz-powered">powered by AgentiCCells</span></p></div>
<!-- agentmap -->
<figure class="vz-agentmap"><svg viewBox="0 0 {{w}} {{h}}" width="100%" role="img" aria-label="{{aria}}"><title>{{aria}}</title>{{body}}</svg><figcaption>{{caption}}</figcaption></figure>
<!-- agentmap-pin -->
<a href="{{href}}"><title>{{title}}</title><g transform="translate({{x}} {{y}})"><circle r="4" class="vz-am-seat" fill="{{c}}"/><g transform="translate({{hx}} {{hy}})">{{head}}</g><text x="{{lx}}" y="{{ly}}" text-anchor="{{anchor}}" class="vz-am-label">{{name}}</text></g></a>
<!-- blast -->
<figure class="vz-blast" style="--c:{{accent}}"><svg viewBox="0 0 {{w}} {{h}}" width="100%" role="img" aria-label="{{aria}}"><title>{{aria}}</title>{{body}}</svg><figcaption>{{caption}}</figcaption></figure>
<!-- blast-pin -->
<a href="{{href}}"><title>{{title}}</title><circle cx="{{x}}" cy="{{y}}" r="{{r}}" class="vz-bl-pin {{cls}}"/><text x="{{lx}}" y="{{ly}}" text-anchor="middle" class="vz-bl-label {{cls}}">{{name}}</text></a>
<!-- tree -->
<div class="vz-tree">{{rows}}</div>
<!-- tree-row -->
<div class="vz-tree-row vz-depth-{{depth}}"><span class="vz-tree-name">{{name}}</span><span class="vz-tree-track"><span class="vz-tree-bar" style="width:{{pct}}%">{{segs}}</span></span><span class="vz-tree-n">{{n}}</span></div>
<!-- tree-seg -->
<i class="vz-seg vz-sig-{{sig}}" style="flex:{{k}}" title="{{title}}"></i>
<!-- tree-key -->
<p class="vz-tree-key">{{items}}</p>
<!-- tree-key-item -->
<span><i class="vz-seg vz-sig-{{sig}}"></i>{{label}}</span>
<!-- nowmap -->
<figure class="vz-nowmap"><svg viewBox="0 0 {{w}} {{h}}" width="100%" role="img" aria-label="{{aria}}"><title>{{aria}}</title>{{body}}</svg><figcaption>{{caption}}</figcaption></figure>
<!-- now-pin -->
<a href="{{href}}"><title>{{title}}</title><circle cx="{{x}}" cy="{{y}}" r="12" class="vz-now-dot" style="fill:{{fill}}"/><text x="{{x}}" y="{{ty}}" text-anchor="middle" class="vz-now-t">{{t}}</text><text x="{{lx}}" y="{{ny}}" text-anchor="{{anchor}}" class="vz-am-label">{{name}}</text><text x="{{lx}}" y="{{ry}}" text-anchor="{{anchor}}" class="vz-now-r">{{r}}</text></a>
