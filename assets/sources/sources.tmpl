<!-- The live sources strip (designer@'s board/spec-the-live-sources-strip.md, L1 to L6): markup; filled by
     newsroom/build/features/live-sources.mjs from assets/sources/sources.json; the look sources.css; the updated time sources.js. -->
<!-- part:strip -->
<nav class="ls-src" aria-label="Live sources"><div class="ls-src-w">{{#items}}</div></nav>
<!-- item:source --><a class="ls-src-a ls-{{tone}}" href="{{url}}" target="_blank" rel="noopener"{{updated}}><span class="ls-src-k"><i aria-hidden="true"></i>{{kicker}}<span class="ls-src-t"></span></span><b>{{name}}</b><span class="ls-src-l"{{until}}>{{line}}</span><code>{{host}} ↗</code></a>
<!-- item:here --><a class="ls-src-here" href="{{href}}">{{name}} →</a>
<!-- end -->
