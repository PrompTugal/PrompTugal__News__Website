<!-- E, the home page (Silvio's mock E, "The Front Page", by design@web-summit.silvio; Dinis, 6 November 2026, about
     22:40 UTC; board/briefs/2026-11-06-front-page-mock-e.md). The component's markup and words, filled from data by
     newsroom/build/features/front-e.mjs ({{name}} is a value, {{#name}} a list made from the matching item below).
     The look: front-e.css; the countdown and Now and next's trim: front-e.js. It is one of the home page's designs (assets/design/, ?design=e). -->
<!-- part:page -->
<div class="fe pt-design" data-design-of="e">
<div class="fe-w"><div class="fe-dl"><time datetime="{{today}}">{{date}}</time><span class="fe-where">Portugal · town by town · Independent</span></div>
<header class="fe-mast"><a href="index.html" aria-label="{{name}}, the home page">{{wordmark}}</a></header>
<nav class="fe-nav" aria-label="Sections">{{#nav}}</nav></div>
{{lead}}
<div class="fe-w">{{nowline}}</div>
<section class="fe-w fe-ptb" aria-label="Portugal, town by town"><div class="fe-ptb-map"><h2 class="fe-h">Portugal, town by town</h2>{{ptmap}}<p class="fe-ptk"><span class="on"></span> a place we cover <span class="next"></span> a district capital, coming next</p></div><div class="fe-pl"><h2 class="fe-h">The Algarve</h2><p class="fe-pli">{{places_intro}}</p><ul>{{#places}}</ul><p class="fe-more"><a href="algarve/index.html">The Algarve</a> · <a href="portugal/index.html">Portugal</a> · <a href="api/swagger/index.html">The API</a></p></div></section>
<div class="fe-w"><div class="fe-cols">
<section class="fe-brf"><h2 class="fe-h">National and international</h2><ol>{{#briefing}}</ol><p class="fe-more">From the summit: <a href="interviews/buzz-messaging-ai/guy-ben-zvi/index.html">Guy Ben Zvi, Buzz Messaging AI</a> · <a href="interviews/student-property-network/leo-tashev-and-fraser-lloyd/index.html">Student Property Network</a> · <a href="summit/index.html">the archive</a> · <a href="agentic/index.html">the GAMMA-Ray spectrum</a></p></section>
<section class="fe-stories"><h2 class="fe-h">From the Algarve</h2>{{#stories}}</section>
<section class="fe-nx"><div class="fe-stats"><p class="fe-rh"><b>By the numbers</b><span>from the place files</span></p><ul>{{#stats}}</ul></div><div class="fe-radar"><p class="fe-rh"><b>The companies we follow</b><span>by field</span></p>{{#radar}}<p class="fe-more"><a href="companies/index.html">All companies, by field</a> · <a href="summit/index.html">Web Summit 2026, the archive</a></p></div></section>
</div></div>
<section class="fe-nums" aria-label="In numbers"><div class="fe-w">{{#nums}}</div></section>
<div class="fe-w fe-ask"><form class="fe-pb" role="search" action="search/index.html" method="get"><span class="fe-pr" aria-hidden="true">&gt;_</span><input name="q" type="search" placeholder="Ask PrompTugal anything" aria-label="Ask PrompTugal"><button type="submit">Ask</button></form><p class="fe-pcs">{{#asks}}</p></div>
</div>
<!-- part:lead -->
<section class="fe-band" aria-label="The lead story"><div class="fe-w"><div><p class="fe-kk">{{kicker}}</p><h2 class="fe-hed"><a href="{{href}}">{{headline}}</a></h2>{{live}}<p class="fe-dek">{{dek}}</p>{{programme}}{{developments}}<p class="fe-lmore"><a href="{{href}}">Read the full story <span aria-hidden="true">→</span></a></p>{{storm}}<p class="fe-by">{{byline}} · {{minutes}} min read</p>{{pill}}</div>{{figure}}</div></section>
<!-- part:none -->
<section class="fe-band" aria-label="The lead story"><div class="fe-w"><div><h2 class="fe-hed">Our first article is on the way.</h2></div></div></section>
