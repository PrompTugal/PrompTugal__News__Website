<!-- E, the home page (Silvio's mock E, "The Front Page", by design@web-summit.silvio; Dinis, 6 November 2026, about
     22:40 UTC; board/briefs/2026-11-06-front-page-mock-e.md). The component's markup and words, filled from data by
     newsroom/build/features/front-e.mjs ({{name}} is a value, {{#name}} a list made from the matching item below).
     The look: front-e.css; the countdown and Now and next's trim: front-e.js. It is one of the home page's designs (assets/design/, ?design=e). -->
<!-- part:page -->
<div class="fe pt-design" data-design-of="e">
<div class="fe-w"><div class="fe-dl"><time datetime="{{today}}">{{date}}</time><span class="fe-cd" data-at="{{opening_at}}">Opening Night in <b data-cd>{{opening_in}}</b></span><span class="fe-where">Lisbon · Independent</span></div>
<header class="fe-mast"><a href="index.html" aria-label="{{name}}, the home page">{{wordmark}}</a></header>
<nav class="fe-nav" aria-label="Sections">{{#nav}}</nav></div>
{{lead}}
{{spectrum}}
<section class="fe-live" aria-label="This week"><h2>This week</h2><div class="fe-tk" tabindex="0" aria-label="This week, scrolling; hover or focus to pause"><div class="fe-tk-in"><ul>{{#week}}</ul><ul aria-hidden="true">{{#week_again}}</ul></div></div></section>
<div class="fe-w"><div class="fe-cols">
<section class="fe-brf"><h2 class="fe-h">The briefing</h2><ol>{{#briefing}}</ol></section>
<section class="fe-stories"><h2 class="visually-hidden">The stories</h2>{{#stories}}</section>
<section class="fe-nx"><h2 class="fe-h">Now and next</h2><ul>{{#next}}</ul><p class="fe-more"><a href="summit/index.html">The summit, day by day</a> · <a href="events/index.html">The agenda</a></p>
<div class="fe-radar"><p class="fe-rh"><b>The companies we follow</b><span>by field</span></p>{{#radar}}<p class="fe-more"><a href="companies/index.html">All companies, by field</a></p></div></section>
</div></div>
<section class="fe-nums" aria-label="In numbers"><div class="fe-w">{{#nums}}</div></section>
<div class="fe-w fe-ask"><form class="fe-pb" role="search" action="search/index.html" method="get"><span class="fe-pr" aria-hidden="true">&gt;_</span><input name="q" type="search" placeholder="Ask PrompTugal anything" aria-label="Ask PrompTugal"><button type="submit">Ask</button></form><p class="fe-pcs">{{#asks}}</p></div>
</div>
<!-- part:lead -->
<section class="fe-band" aria-label="The lead story"><div class="fe-w"><div><p class="fe-kk">{{kicker}}</p><h2 class="fe-hed"><a href="{{href}}">{{headline}}</a></h2>{{live}}<p class="fe-dek">{{dek}}</p>{{programme}}{{developments}}<p class="fe-lmore"><a href="{{href}}">Read the full story <span aria-hidden="true">→</span></a></p><p class="fe-by">{{byline}} · {{minutes}} min read</p>{{pill}}</div>{{figure}}</div></section>
<!-- part:none -->
<section class="fe-band" aria-label="The lead story"><div class="fe-w"><div><h2 class="fe-hed">Our first article is on the way.</h2></div></div></section>
