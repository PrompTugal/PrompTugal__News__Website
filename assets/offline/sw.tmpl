/* sw.js: PrompTugal.news offline (Dinis 18:05, Silvio's idea; board/passes/2026-11-06-offline-mode.md). Made by
 * newsroom/build/features/offline.mjs from assets/offline/sw.tmpl at every release: the release and the list of
 * pages to keep are filled in. No dependency.
 *   - Public pages of this site only: a request to another origin, a request that is not GET, a request with an
 *     Authorization header or a query string is never stored (the vaults, the chat and search pass straight through),
 *     and neither is a page that uses a person's key (/login/, the drain: NEVER).
 *   - Network first: the network answers when it can (and the answer is kept); the cache answers when it cannot,
 *     or when a page takes more than a few seconds and a copy is kept.
 *   - Three caches: pt-shell-<version> (what every visit keeps: the shell, the front page, the summit and its days,
 *     the agenda data, the newest articles), pt-pages (the pages read, at most MAX), pt-saved (what the reader
 *     saved). The page clears them all with PTOffline.clear() (assets/offline/offline.js). */
const V = '__VERSION__', SHELL = 'pt-shell-' + V, PAGES = 'pt-pages', SAVED = 'pt-saved', MAX = 150, WAIT = 4000
const KEEP = __PRECACHE__
const NEVER = __NEVER__   // the pages that use a person's key (security@): never kept, never answered from a copy
// pages taken off the site (the websummit-only pass): the first 16 hex of SHA-256 of '<kind>/<id>', so this file names
// nobody; a kept or saved copy of one is dropped when this worker takes over
const GONE = new Set(__GONE__)
const scope = self.registration.scope
// a page is one key whether asked as <path>/ or <path>/index.html (sherpa@'s O6: the tabs ask for index.html)
const keyOf = u => u.origin + u.pathname.replace(/\/index\.html$/, '/')

async function stamp(res) {
    const h = new Headers(res.headers); h.set('x-pt-saved', new Date().toISOString())
    return new Response(await res.blob(), { status: res.status, statusText: res.statusText, headers: h })
}
// the newest kept copy of a page, whichever cache holds it (dev@PrompTugal.vicky's diagnosis, 11 November: caches.match()
// answered from the oldest cache, the release's install snapshot, before the newer copy kept on reading)
async function newest(key) {
    let best = null, at = ''
    for (const name of [PAGES, SAVED, SHELL]) { const r = await (await caches.open(name)).match(key); if (r) { const t = r.headers.get('x-pt-saved') || ''; if (!best || t > at) { best = r; at = t } } }
    return best
}
// the pages last answered from a kept copy in this worker's life, with when that copy was saved: the page asks on load
// and labels itself (11 November: a kept copy is always labelled, not only when the device is offline)
const KEPT = new Map()
self.addEventListener('message', ev => { if (ev.data && ev.data.type === 'pt-which' && ev.source) { const at = KEPT.get(keyOf(new URL(ev.data.url))); ev.source.postMessage({ type: 'pt-kept', at: at || '' }) } })
async function trim(c) { const ks = await c.keys(); for (const k of ks.slice(0, Math.max(0, ks.length - MAX))) await c.delete(k) }

self.addEventListener('install', e => e.waitUntil((async () => {
    const c = await caches.open(SHELL)
    await Promise.all(KEEP.map(async p => { try { const u = new URL(p, scope), r = await fetch(u, { cache: 'no-cache' }); if (r.ok) await c.put(keyOf(u), await stamp(r)) } catch (e) { } }))
    await self.skipWaiting()
})()))

self.addEventListener('activate', e => e.waitUntil((async () => {
    for (const k of await caches.keys()) if (k.startsWith('pt-shell-') && k !== SHELL) await caches.delete(k)
    if (GONE.size) for (const name of [PAGES, SAVED]) { const c = await caches.open(name)
        for (const r of await c.keys()) { const m = new URL(r.url).pathname.match(/\/(people|events|organisations|places|companies)\/([^/]+)\//); if (!m) continue
            const h = [...new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(m[1] + '/' + m[2])))].map(b => b.toString(16).padStart(2, '0')).join('').slice(0, 16)
            if (GONE.has(h)) await c.delete(r) } }
    await self.clients.claim()
})()))

// the offline page (sherpa@'s O3): in the site's look, listing by title every page kept on this device
const esc = t => String(t).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c])
async function offlinePage() {
    const seen = new Set(), rows = []
    for (const name of [SAVED, PAGES, SHELL]) {
        const c = await caches.open(name)
        for (const k of await c.keys()) {
            const u = new URL(k.url); if (seen.has(u.href) || !/(\/|\.html)$/.test(u.pathname)) continue
            seen.add(u.href)
            try { const t = ((await (await c.match(k)).text()).match(/<title>([^<]*)<\/title>/) || [])[1]; if (t) rows.push([u.href, t.replace(/ · PrompTugal\.news$/, ''), name === SAVED]) } catch (e) { }
            if (rows.length >= 80) break
        }
    }
    const li = r => `<li><a href="${esc(r[0])}">${esc(r[1])}</a>${r[2] ? ' <b>saved</b>' : ''}</li>`
    return `<!doctype html><html lang="en-GB"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Offline · PrompTugal.news</title>
<link rel="stylesheet" href="${scope}assets/site.css"><body><div class="frame"><main id="main"><header class="page-head"><h1>You are offline</h1>
<p class="lead">This page was not kept on this device. These were, and open now:</p></header><div class="body"><ul class="rows">${rows.map(li).join('')}</ul>
<p>The site updates itself when the network is back.</p></div></main></div></body></html>`
}

self.addEventListener('fetch', e => {
    const r = e.request, u = new URL(r.url)
    if (r.method !== 'GET' || u.origin !== self.location.origin || r.headers.has('authorization')) return
    if (NEVER.some(p => u.href.startsWith(new URL(p, scope).href))) return
    const key = keyOf(u)
    // a page with a query (?design=e, search?q=) is never stored; offline it opens its page's copy, else the offline page (O2)
    if (u.search) {
        if (r.mode !== 'navigate') return
        e.respondWith(fetch(r).catch(async () => (await newest(key)) || (await caches.match(new URL('offline/', scope).href)) || new Response(await offlinePage(), { status: 503, headers: { 'content-type': 'text/html; charset=utf-8' } })))
        return
    }
    e.respondWith((async () => {
        // a page past the browser's own HTTP cache (the host's max-age=600 made a reload ten minutes old)
        const go = r.mode === 'navigate' ? fetch(r.url, { cache: 'no-cache', credentials: 'same-origin' }) : fetch(r)
        let late = false
        const net = go.then(async res => {
            if (res.ok && res.type === 'basic') { if (!late) KEPT.delete(key); const c = await caches.open(PAGES); await c.put(key, await stamp(res.clone())); trim(c)
                // the network came after a kept copy was shown: the page is told a newer copy is here
                if (late && r.mode === 'navigate') { const cl = await self.clients.get(e.resultingClientId || e.clientId); if (cl) cl.postMessage({ type: 'pt-newer' }) } }
            return res
        })
        try {
            return await Promise.race([net, new Promise((_, no) => setTimeout(() => no(new Error('slow')), WAIT))])
        } catch (err) {
            const kept = await newest(key)
            if (kept) { late = true; if (r.mode === 'navigate') KEPT.set(key, kept.headers.get('x-pt-saved') || '?'); net.catch(() => { }); return kept }
            try { return await net } catch (e2) { }
            if (r.mode === 'navigate') return (await caches.match(new URL('offline/', scope).href)) || new Response(await offlinePage(), { status: 503, headers: { 'content-type': 'text/html; charset=utf-8' } })
            return Response.error()
        }
    })())
})
