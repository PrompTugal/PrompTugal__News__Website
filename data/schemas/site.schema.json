{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/site.schema.json",
  "title": "The shell's words (data/site/site.json)",
  "type": "object",
  "required": [
    "name",
    "motto",
    "dateline",
    "countdown",
    "agent",
    "operator",
    "repo",
    "team_site",
    "licence",
    "footer_note",
    "place",
    "endorse",
    "promise",
    "independence",
    "disclosure",
    "disclosure_href",
    "ears"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "about": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "motto": {
      "type": "string",
      "minLength": 1
    },
    "dateline": {
      "type": "string",
      "minLength": 1
    },
    "countdown": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "day1": {
          "type": "string"
        }
      }
    },
    "agent": {
      "$ref": "common.schema.json#/$defs/agent"
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "$ref": "common.schema.json#/$defs/url"
    },
    "team_site": {
      "$ref": "common.schema.json#/$defs/url"
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "footer_note": {
      "type": "string",
      "minLength": 1
    },
    "place": {
      "type": "string",
      "minLength": 1
    },
    "promise": {
      "type": "string",
      "minLength": 1
    },
    "independence": {
      "type": "string",
      "minLength": 1
    },
    "disclosure": {
      "type": "string",
      "minLength": 1
    },
    "disclosure_href": {
      "type": "string",
      "minLength": 1
    },
    "endorse": {
      "type": "object",
      "required": [
        "label",
        "name",
        "href",
        "mark"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "mark": {
          "type": "string",
          "minLength": 1
        },
        "mark_dark": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ears": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "share": {
      "type": "object",
      "description": "The share row's words (newsroom/build/features/share.mjs).",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        },
        "copied": {
          "type": "string"
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkedin": {
              "type": "string"
            },
            "x": {
              "type": "string"
            },
            "whatsapp": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
