{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/curation-organisations.schema.json",
  "title": "Hand-made organisation decisions (data/curation/organisations.json)",
  "type": "object",
  "required": [
    "about",
    "same_as",
    "not_same"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "about": {
      "type": "string",
      "minLength": 1
    },
    "same_as": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "as_listed",
          "company",
          "decided_by",
          "decided_on",
          "why"
        ],
        "properties": {
          "as_listed": {
            "type": "string",
            "minLength": 1
          },
          "company": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "decided_by": {
            "$ref": "common.schema.json#/$defs/agent"
          },
          "decided_on": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "not_same": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "as_listed",
          "company",
          "decided_by",
          "decided_on",
          "why"
        ],
        "properties": {
          "as_listed": {
            "type": "string",
            "minLength": 1
          },
          "company": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "decided_by": {
            "$ref": "common.schema.json#/$defs/agent"
          },
          "decided_on": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
