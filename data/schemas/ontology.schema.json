{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-summit.newsroom.sgit.ai/data/schemas/ontology.schema.json",
  "title": "The ontology (data/ontology.json)",
  "type": "object",
  "required": [
    "id",
    "version",
    "about",
    "rules",
    "worlds",
    "types",
    "verbs",
    "forbidden",
    "taxonomies"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "about": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "worlds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "types",
          "meaning"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "world",
          "page",
          "meaning"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "world": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": [
              "string",
              "null"
            ]
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "verbs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "verb",
          "inverse",
          "from",
          "to",
          "world",
          "reads",
          "reads_inverse",
          "meaning"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "inverse": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "from": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "world": {
            "type": "string",
            "minLength": 1
          },
          "bridge": {
            "type": "boolean"
          },
          "reads": {
            "type": "string",
            "minLength": 1
          },
          "reads_inverse": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "verb",
          "why"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "taxonomies": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
