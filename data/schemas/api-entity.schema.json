{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-summit.newsroom.sgit.ai/data/schemas/api-entity.schema.json",
  "title": "An entity (/api/v1/<type>/<slug>.json)",
  "type": "object",
  "required": [
    "id",
    "ref",
    "type",
    "label",
    "page",
    "graph"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "page": {
      "type": [
        "string",
        "null"
      ]
    },
    "graph": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
