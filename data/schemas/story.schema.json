{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-summit.newsroom.sgit.ai/data/schemas/story.schema.json",
  "title": "A story candidate (data/stories/<id>/story.json)",
  "description": "From the curator's maps; its angle and notes stay in the desk's file.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "beat",
    "topic",
    "status",
    "rests_on",
    "desk_files"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "type": {
      "const": "story"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "beat": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/topic_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "assigned",
        "published",
        "dropped"
      ]
    },
    "rests_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evidence:[A-Za-z0-9-]+$"
      }
    },
    "desk_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "derived": {
      "$ref": "common.schema.json#/$defs/derived"
    }
  },
  "additionalProperties": false
}
