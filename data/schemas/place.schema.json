{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/place.schema.json",
  "title": "A place (data/places/<slug>/place.json)",
  "description": "Hand-edited. \"matches\" are the exact strings (a whole \"where\", or a stage name in the summit's \"Stage (Track), Venue\" form) that the derivation maps to this place.",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "kind",
    "located_in",
    "matches",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "type": {
      "const": "place"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "country",
        "region",
        "city",
        "district",
        "street",
        "venue",
        "building",
        "stage",
        "room"
      ]
    },
    "located_in": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/place_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/url_or_path"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "by",
          "how"
        ],
        "properties": {
          "url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "read_at": {
            "$ref": "common.schema.json#/$defs/read_at"
          },
          "read_on": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "by": {
            "$ref": "common.schema.json#/$defs/agent"
          },
          "how": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "description": "Further public sources (the websummit-only pass, 11 Nov 2026): a fact with one of these is not websummit-only."
    },
    "neighbours": {
      "type": "array",
      "description": "places that share a land border with this one, each with its source and the date read",
      "items": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "place": {
            "$ref": "common.schema.json#/$defs/place_ref"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "a neighbour that is not a place of ours (outside the Algarve)"
          },
          "source": {
            "type": "object",
            "required": [
              "url",
              "read_at",
              "how"
            ],
            "properties": {
              "url": {
                "$ref": "common.schema.json#/$defs/url"
              },
              "read_at": {
                "$ref": "common.schema.json#/$defs/read_at"
              },
              "by": {
                "$ref": "common.schema.json#/$defs/agent"
              },
              "how": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "border_km": {
            "type": "number",
            "minimum": 0,
            "description": "the length of the shared boundary, in km, where the source gives it"
          }
        },
        "additionalProperties": false
      }
    },
    "wikidata": {
      "type": "object",
      "required": [
        "id",
        "read_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "read_at": {
          "$ref": "common.schema.json#/$defs/read_at"
        },
        "how": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "the Wikidata item this is the same thing as (https://www.wikidata.org/wiki/<id>), read on the date; never guessed: no item, no field"
    }
  },
  "additionalProperties": false
}
