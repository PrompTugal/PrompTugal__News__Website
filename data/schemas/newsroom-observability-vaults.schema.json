{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/newsroom-observability-vaults.schema.json",
  "title": "The observability vaults the newsroom section reads in the browser (data/newsroom/observability/vaults.json): published read keys only",
  "type": "object",
  "required": [
    "about",
    "vaults"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "about": {
      "type": "string",
      "minLength": 1
    },
    "vaults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "site",
          "vault_id",
          "read_key"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "site": {
            "type": "string",
            "minLength": 1
          },
          "vault_id": {
            "type": "string",
            "pattern": "^[a-z0-9]{8,12}$"
          },
          "read_key": {
            "type": "string",
            "pattern": "^sgit_public_read_[0-9a-f]{64}$"
          },
          "kept_by": {
            "type": "string"
          },
          "made": {
            "type": "string"
          },
          "private_data_vault": {
            "type": "string",
            "pattern": "^[a-z0-9]{8,12}$"
          },
          "drain": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
