{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/newsroom-status.schema.json",
  "title": "The newsroom section as JSON (/api/v1/newsroom/status.json): runs, agents, the pipeline and the plan",
  "type": "object",
  "required": [
    "about",
    "version",
    "built",
    "counts",
    "agents",
    "pipeline",
    "build_order",
    "waiting",
    "runs"
  ],
  "properties": {
    "about": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "built": {
      "type": "string",
      "format": "date"
    },
    "counts": {
      "type": "object"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "status",
          "runs",
          "page"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          },
          "last_run": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "page": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "pipeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "state"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "build_order": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "title",
          "state"
        ]
      }
    },
    "waiting": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "who"
        ]
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "when",
          "source",
          "by",
          "what"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "enum": [
              "commit",
              "desk-report"
            ]
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
