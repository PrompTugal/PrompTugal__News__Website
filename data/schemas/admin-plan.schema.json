{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-summit.newsroom.sgit.ai/data/schemas/admin-plan.schema.json",
  "title": "The plan and its state (data/admin/plan.json), hand-kept",
  "type": "object",
  "required": [
    "about",
    "updated",
    "by",
    "glance",
    "build_order",
    "waiting",
    "schedule",
    "lab"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "about": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "by": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+@web-summit\\.[a-z0-9-]+$"
    },
    "glance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "of10",
          "note"
        ],
        "properties": {
          "part": {
            "type": "string",
            "minLength": 1
          },
          "of10": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "build_order": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "state",
          "note",
          "evidence",
          "short"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "done",
              "started",
              "not yet"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "short": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "waiting": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "who",
          "unblocks"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "who": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "pattern": "^WS-\\d+$"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "unblocks": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "phases",
        "order"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "from",
              "to",
              "times"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "format": "date"
              },
              "to": {
                "type": "string",
                "format": "date"
              },
              "times": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$"
                }
              },
              "plus": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "lab": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "state",
          "what"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "idea",
              "trying",
              "done",
              "dropped"
            ]
          },
          "what": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
