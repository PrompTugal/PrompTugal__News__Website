{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/by-place.schema.json",
  "title": "One place's site: its research (data/by-place/<id>.json)",
  "description": "Written by the place's own agent (place.<id>@PrompTugal.dinis), every fact with its URL and the date read. Passes the PrompTugal test: AI directly or within two or three steps, the path written down.",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "parent",
    "mandate",
    "status",
    "updated",
    "by"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "country",
        "region",
        "municipality",
        "city"
      ]
    },
    "parent": {
      "type": "string"
    },
    "status": {
      "enum": [
        "stub",
        "researching",
        "live"
      ]
    },
    "updated": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "mandate": {
      "type": "string",
      "minLength": 10
    },
    "gravity": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "read_on": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "look": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "landmark": {
          "type": "string"
        },
        "motif": {
          "type": "string"
        },
        "photo": {
          "type": "object",
          "description": "A picture of the place under a free licence (or AI-made, said so), hosted in assets/by-place/photos/ (no hotlinking); shown as a band under the page head with its credit, nothing when absent.",
          "required": [
            "file",
            "licence"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^assets/by-place/photos/[a-z0-9._-]+\\.(jpg|jpeg|png|webp)$"
            },
            "alt": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "licence": {
              "type": "string"
            },
            "licence_url": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        }
      }
    },
    "ai_news": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "read_on",
          "ai_path"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "read_on": {
            "type": "string"
          },
          "ai_path": {
            "type": "string"
          },
          "steps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "ai_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_url",
          "read_on"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "company",
              "startup",
              "organisation",
              "institution",
              "community",
              "public body",
              "investor"
            ]
          },
          "url": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "read_on": {
            "type": "string"
          },
          "ai_path": {
            "type": "string"
          },
          "steps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "feed": {}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "read_on": {
            "type": "string"
          },
          "ai_path": {}
        }
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value",
          "source_url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "read_on": {
            "type": "string"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "lede": {
          "type": "string"
        },
        "mandate": {
          "type": "string"
        },
        "gravity": {
          "type": "string"
        },
        "gaps_intro": {
          "type": "string"
        }
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string"
        },
        "signed_by": {
          "type": "string"
        }
      }
    },
    "start_company": {
      "type": "array",
      "description": "Starting a company here: the public routes (incubators, the council's business desk, funding, mentoring, spaces), each from its own public page.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_url",
          "read_on"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "read_on": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "incubator, accelerator, public desk, funding, mentoring, community, space"
          }
        }
      }
    },
    "investors": {
      "type": "array",
      "description": "The investment map: investors known here, funds and programmes, and investments made in companies here, each from a public source.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_url",
          "read_on"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "read_on": {
            "type": "string"
          },
          "type": {
            "enum": [
              "investor",
              "fund",
              "programme",
              "investment",
              "grant"
            ]
          },
          "amount": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "ai_path": {
            "type": "string"
          }
        }
      }
    },
    "talent": {
      "type": "array",
      "description": "Local talent: people who have spoken publicly or agreed to be listed; public and professional facts only, never a personal contact.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_url",
          "read_on"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "read_on": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "consent": {
            "type": "string",
            "description": "how the person agreed to be listed (Dinis's word, a public post), when they are not a public figure"
          }
        }
      }
    },
    "contacts": {
      "type": "array",
      "description": "Official contacts only (CLAUDE.md, 15 Nov 2026): a channel published on a public website, above all a public body's, linked to the page it came from with the date read; never a private individual's.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_url",
          "read_on"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "read_on": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "description": "the official channel as published (a public body's web form, its published office email or phone)"
          }
        }
      }
    }
  }
}
