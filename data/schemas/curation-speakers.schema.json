{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-summit.newsroom.sgit.ai/data/schemas/curation-speakers.schema.json",
  "title": "Hand-made speaker splits (data/curation/speakers.json)",
  "type": "object",
  "required": [
    "about",
    "splits"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "about": {
      "type": "string",
      "minLength": 1
    },
    "splits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "as_listed",
          "role",
          "organisation",
          "decided_by",
          "decided_on",
          "why"
        ],
        "properties": {
          "as_listed": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "organisation": {
            "type": "string",
            "minLength": 1
          },
          "decided_by": {
            "$ref": "common.schema.json#/$defs/agent"
          },
          "decided_on": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
