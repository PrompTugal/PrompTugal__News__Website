{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/story-claims.schema.json",
  "title": "The claims of a story project (data/stories/<id>/claims.json)",
  "type": "object",
  "required": [
    "story",
    "kept_by",
    "claims"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "story": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
      "description": "The story's id: the folder's name (data/stories/<id>/)."
    },
    "kept_by": {
      "$ref": "common.schema.json#/$defs/agent"
    },
    "updated": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "kind",
          "source",
          "read_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "fact",
              "estimate",
              "opinion"
            ]
          },
          "source": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "quote_language": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "published": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "read_on": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "about": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^((company|organisation|person|event|place|topic|story|article):[A-Za-z0-9][A-Za-z0-9-]*|local:[a-z0-9][a-z0-9-]*)$",
              "description": "An entity of the graph (<type>:<id>), or local:<slug> for one this project names that the graph does not have yet."
            }
          },
          "by": {
            "$ref": "common.schema.json#/$defs/agent"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "Every claim the story rests on, each marked fact (the source states it), estimate (a number the source gives as approximate, or a sum we made, said so) or opinion (someone's view, attributed), with its source and, where useful, the source's words."
}
