{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/company-sources.schema.json",
  "title": "A company's sources (data/companies/<id>/sources.json)",
  "type": "object",
  "required": [
    "company",
    "sources"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "company": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "read_on",
          "read_by",
          "supports",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "read_on": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "read_by": {
            "$ref": "common.schema.json#/$defs/agent"
          },
          "supports": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "summit-appearance",
              "summit-session",
              "summit-attendee",
              "summit-list",
              "other"
            ]
          },
          "vault_capture": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
