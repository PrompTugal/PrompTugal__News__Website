{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/organisation-network.schema.json",
  "title": "An organisation's network: its programmes, partners, figures and roles (data/organisations/<id>/network.json)",
  "description": "Hand-kept by ontologist@PrompTugal.dinis. One source for an organisation's section and its graphs: programmes (programme:<slug>, local to this file), roles (role:<slug>, a public role named by a source; a person's name only after the naming decision allows it), figures as claims with their kind (fact or self-reported), and edges whose ends are graph entities or this file's programmes and roles. Every item cites its source and the date read.",
  "type": "object",
  "required": [
    "organisation",
    "kept_by",
    "updated",
    "programmes",
    "roles",
    "figures",
    "edges"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "organisation": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "kept_by": {
      "$ref": "common.schema.json#/$defs/agent"
    },
    "updated": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "programmes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "what",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^programme:[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "since": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url",
                "read_on",
                "by"
              ],
              "properties": {
                "url": {
                  "$ref": "common.schema.json#/$defs/url"
                },
                "read_on": {
                  "$ref": "common.schema.json#/$defs/date"
                },
                "by": {
                  "$ref": "common.schema.json#/$defs/agent"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "named_in_source",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^role:[a-z0-9-]+$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "named_in_source": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Only once the decision on naming people allows it."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url",
                "read_on",
                "by"
              ],
              "properties": {
                "url": {
                  "$ref": "common.schema.json#/$defs/url"
                },
                "read_on": {
                  "$ref": "common.schema.json#/$defs/date"
                },
                "by": {
                  "$ref": "common.schema.json#/$defs/agent"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "value",
          "kind",
          "sources"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "fact",
              "self-reported",
              "target",
              "estimate"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url",
                "read_on",
                "by"
              ],
              "properties": {
                "url": {
                  "$ref": "common.schema.json#/$defs/url"
                },
                "read_on": {
                  "$ref": "common.schema.json#/$defs/date"
                },
                "by": {
                  "$ref": "common.schema.json#/$defs/agent"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "verb",
          "to",
          "sources"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^(company|organisation|person|event|place|topic|programme|role):[a-z0-9-]+$"
          },
          "verb": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^(company|organisation|person|event|place|topic|programme|role):[a-z0-9-]+$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url",
                "read_on",
                "by"
              ],
              "properties": {
                "url": {
                  "$ref": "common.schema.json#/$defs/url"
                },
                "read_on": {
                  "$ref": "common.schema.json#/$defs/date"
                },
                "by": {
                  "$ref": "common.schema.json#/$defs/agent"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "verbs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "verb",
          "inverse",
          "meaning"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "minLength": 1
          },
          "inverse": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
