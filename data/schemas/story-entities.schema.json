{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptugal.news/data/schemas/story-entities.schema.json",
  "title": "The entities of a story project (data/stories/<id>/entities.json)",
  "type": "object",
  "required": [
    "story",
    "kept_by",
    "entities"
  ],
  "properties": {
    "$schema": {
      "$ref": "common.schema.json#/$defs/schema_link"
    },
    "story": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
      "description": "The story's id: the folder's name (data/stories/<id>/)."
    },
    "kept_by": {
      "$ref": "common.schema.json#/$defs/agent"
    },
    "updated": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "label",
          "kind",
          "sources"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^((company|organisation|person|event|place|topic|story|article):[A-Za-z0-9][A-Za-z0-9-]*|local:[a-z0-9][a-z0-9-]*)$",
            "description": "An entity of the graph (<type>:<id>), or local:<slug> for one this project names that the graph does not have yet."
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "company",
              "organisation",
              "person",
              "event",
              "place",
              "topic",
              "programme",
              "group",
              "other"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "organisation": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "Who and what the story is about: each an entity of the graph or a local one not yet in it, with the sources that name it. People: name, role and organisation as a public page lists them, nothing else."
}
