{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasci-quality-all.schema.json",
  "title": "The data quality of every place (api/v1/places/quality.json)",
  "description": "datasci.places@PrompTugal.dinis, 15 November 2026: one row per place, columns named once, the summary and the method.",
  "type": "object",
  "required": ["about", "version", "method", "summary", "columns", "rows", "places"],
  "properties": {
    "about": { "type": "string" },
    "version": { "type": "string" },
    "built": { "type": "string", "format": "date" },
    "method": { "type": "object" },
    "summary": { "type": "object", "required": ["places", "facts"], "properties": { "places": { "type": "integer", "minimum": 0 }, "facts": { "type": "integer", "minimum": 0 } } },
    "columns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "rows": { "type": "array", "items": { "type": "array" } },
    "places": { "type": "array", "items": { "type": "object", "required": ["id", "name", "score", "quality"] } }
  }
}
