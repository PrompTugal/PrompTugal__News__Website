# Generated by newsroom/build/build.mjs: CI builds, validates and deploys them; they are never committed.
# The build lists what it wrote in .generated.txt; the gate fails if a file is ignored that the build did not write
# (a source CI would never see). Every page is HTML with a markdown twin beside it, so: all HTML and all markdown are
# ignored, except where markdown is a source (the folders below and the repository's own documents at the top).
*.html
*.md
!/content/**
!/data/**
!/desks/**
!/board/**
!/newsroom/build/**
!/newsroom/tools/**
!/assets/**
!/.github/**
!/*.md
/index.md
/404.md
# the JSON API (/api/v1/), and the build's own records
/api/
/llms.txt
/sitemap.xml
/robots.txt
/.generated.txt

# Credentials tier: never committed (session keys, vault keys, tokens, key stores)
.credentials/
.sg-send/
.sg_vault/
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# Local noise
node_modules/
__pycache__/
*.log
.DS_Store
