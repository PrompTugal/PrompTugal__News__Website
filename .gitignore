# Generated by admin/build/build.mjs: CI builds, validates and deploys them; they are never committed.
# The build lists what it wrote in .generated.txt; the gate fails if a source file is ignored.
*.html
/index.md
/404.md
/about/*.md
/articles/*.md
/brief/**/*.md
/brief/*.md
/admin/*.md
/summit/*.md
/companies/*.md
/companies/**/*.md
/llms.txt
/sitemap.xml
/robots.txt
/.generated.txt

# Credentials tier: never committed (session keys, vault keys, tokens, key stores)
.credentials/
.sg-send/
.sg_vault/
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# Local noise
node_modules/
__pycache__/
*.log
.DS_Store
