<!-- 7 · talent -->
<section class="slide">
  <div class="head"><span><b>Talent</b></span><span>07</span></div>
  <div class="kicker">Found here, instead of leaving</div>
  <h2 style="font-size:64px">A map of who does what in the Algarve, and the skills that are here.</h2>
  <div class="cols w60 center" style="margin-top:36px;gap:60px">
    <svg viewBox="0 0 980 560" width="980" height="560">
      <defs><marker id="ar7" markerWidth="10" markerHeight="10" refX="9" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#595c64"/></marker></defs>
      <g stroke="#595c64" stroke-width="2.5" marker-end="url(#ar7)">
        <line x1="490" y1="280" x2="210" y2="110"/><line x1="490" y1="280" x2="780" y2="110"/><line x1="490" y1="280" x2="180" y2="440"/><line x1="490" y1="280" x2="800" y2="440"/><line x1="490" y1="280" x2="490" y2="490"/>
      </g>
      <g font-size="20" fill="#3f424a" class="mono" text-anchor="middle" stroke="#f6f3ec" stroke-width="10" paint-order="stroke" stroke-linejoin="round">
        <text x="350" y="202">works at</text>
        <text x="635" y="202">has skills in</text>
