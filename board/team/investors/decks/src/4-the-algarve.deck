      <circle cx="470" cy="350" r="30" fill="#121317"/><text x="470" y="410">Talent</text>
      <circle cx="660" cy="420" r="30" fill="#8a6d1f"/><text x="660" y="480">Investors</text>
      <circle cx="120" cy="470" r="30" fill="#5a7fc4"/><text x="120" y="530">Programmes</text>
      <circle cx="400" cy="520" r="30" fill="#9d9580"/><text x="400" y="580">Municipalities</text>
    </g>
    <line x1="780" y1="300" x2="880" y2="300" stroke="#006600" stroke-width="6" marker-end="url(#ar4)"/>
    <rect x="910" y="0" width="770" height="600" fill="#fffdf8" stroke="#006600" stroke-width="3"/>
    <text x="940" y="44" class="mono" font-size="20" fill="#006600" letter-spacing="2">WITH PROMPTUGAL · ONE SOURCED MAP</text>
    <g stroke="#006600" stroke-width="3" opacity=".75">
      <line x1="1295" y1="320" x2="1295" y2="120"/><line x1="1295" y1="320" x2="1436" y2="179"/><line x1="1295" y1="320" x2="1495" y2="320"/><line x1="1295" y1="320" x2="1436" y2="461"/>
      <line x1="1295" y1="320" x2="1295" y2="520"/><line x1="1295" y1="320" x2="1154" y2="461"/><line x1="1295" y1="320" x2="1095" y2="320"/><line x1="1295" y1="320" x2="1154" y2="179"/>
    </g>
    <polygon points="1295,120 1436,179 1495,320 1436,461 1295,520 1154,461 1095,320 1154,179" fill="none" stroke="#9d9580" stroke-width="2"/>
    <circle cx="1295" cy="320" r="86" fill="#121317"/>
    <text x="1295" y="318" text-anchor="middle" class="serif" font-size="30" font-weight="600" fill="#f6f3ec">PrompTugal</text>
    <text x="1295" y="348" text-anchor="middle" font-size="19" fill="#c8c4ba">the map</text>
    <g font-size="22" fill="#121317">
      <circle cx="1295" cy="120" r="28" fill="#006600"/><text x="1335" y="100">Companies</text>
      <circle cx="1436" cy="179" r="28" fill="#4caf50"/><text x="1474" y="170">Startups</text>
      <circle cx="1495" cy="320" r="28" fill="#1f4fa8"/><text x="1533" y="328">University</text>
      <circle cx="1436" cy="461" r="28" fill="#c52830"/><text x="1474" y="478">Events</text>
