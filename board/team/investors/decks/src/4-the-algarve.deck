    <g stroke="#9d9580" stroke-width="2.5" fill="none">
      <path d="M540,300 C580,300 560,90 600,90"/><path d="M540,300 C580,300 560,190 600,190"/><path d="M540,300 L600,300"/><path d="M540,300 C580,300 560,410 600,410"/><path d="M540,300 C580,300 560,510 600,510"/>
    </g>
    <g font-size="22" fill="#121317">
      <rect x="600" y="60" width="440" height="62" fill="#fffdf8" stroke="#006600" stroke-width="2"/><text x="622" y="99"><tspan font-weight="600">The web page</tspan> · people, on any device</text>
