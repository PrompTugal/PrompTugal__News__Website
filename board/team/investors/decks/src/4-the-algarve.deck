<!-- 5 · news for the Algarve -->
<section class="slide">
  <div class="head"><span><b>News</b></span><span>05</span></div>
  <div class="cols w40" style="margin-top:0;gap:80px;height:100%">
    <div>
      <div class="kicker">A regional beat</div>
      <h2 style="font-size:64px">What is going on in the Algarve, every day, sourced.</h2>
      <div style="margin-top:44px">
        <div class="mini"><h3>Events and launches</h3><p>What is on, who runs it, what came out of it: kept current, not written once and forgotten.</p></div>
        <div class="mini r"><h3>Every fact with its source</h3><p>The public page it came from and the date it was read; every article signed.</p></div>
        <div class="mini c"><h3>Portuguese and English</h3><p>For the region and for the world reading about it, as the platform becomes multilingual.</p></div>
      </div>
    </div>
    <div class="feed" style="align-self:center">
      <div class="lbl">The Algarve · from our sourced page</div>
      <div class="it"><div class="d">7 Nov 2026 · Lagos</div><div class="t">DevFest Lagos 2026, with Algarve Evolution as a partner</div><div class="s">algarveevolution.pt, read 6 Nov 2026</div></div>
      <div class="it"><div class="d">Oct 2026 · programme</div><div class="t">Founder2Founder: a six-month growth programme, 8 companies from 41 applications</div><div class="s">Portugal Startup News, 1 Nov 2026</div></div>
      <div class="it"><div class="d">Jan 2026 · incubator</div><div class="t">Algarve Evolution's incubator recognised by Startup Portugal</div><div class="s">Portugal Startup News, 1 Nov 2026</div></div>
      <div class="it"><div class="d">2027 · Algarve Tech Hub Summit</div><div class="t">Confirmed to return; no date or venue announced yet</div><div class="s">Portugal Startup News, 1 Nov 2026</div></div>
    </div>
  </div>
  <div class="foot"><span class="wordmark">Promp<span class="t">T</span><span class="u">ugal</span><i>.news</i></span><span>The Algarve · items from promptugal.news/portugal/algarve-evolution/</span></div>
</section>

<!-- 6 · distribution -->
<section class="slide">
  <div class="head"><span><b>Distribution</b></span><span>06</span></div>
