    <g stroke="#9d9580" stroke-width="2" stroke-dasharray="6 8" fill="none">
      <line x1="120" y1="150" x2="300" y2="120"/><line x1="560" y1="180" x2="470" y2="340"/><line x1="220" y1="330" x2="130" y2="450"/>
    </g>
    <g font-size="22" text-anchor="middle" fill="#121317">
      <circle cx="120" cy="150" r="30" fill="#006600"/><text x="120" y="210">Companies</text>
      <circle cx="320" cy="115" r="30" fill="#4caf50"/><text x="320" y="175">Startups</text>
      <circle cx="580" cy="170" r="30" fill="#1f4fa8"/><text x="580" y="230">University</text>
