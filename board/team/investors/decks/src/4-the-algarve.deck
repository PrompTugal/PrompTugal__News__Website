        <text x="680" y="372">lives and works in</text>
        <text x="490" y="420">studied at</text>
      </g>
      <circle cx="490" cy="280" r="92" fill="#121317"/>
      <text x="490" y="276" text-anchor="middle" class="serif" font-size="30" font-weight="600" fill="#f6f3ec">A person</text>
      <text x="490" y="306" text-anchor="middle" font-size="19" fill="#c8c4ba">public role only</text>
      <g font-size="24" font-weight="600" text-anchor="middle">
        <rect x="80" y="50" width="260" height="70" fill="#006600"/><text x="210" y="94" fill="#fff">A company</text>
        <rect x="650" y="50" width="260" height="70" fill="#1f4fa8"/><text x="780" y="94" fill="#fff">A skill, a topic</text>
