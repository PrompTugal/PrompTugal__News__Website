    <div>
      <div class="lbl2">Already kept for the summit</div>
      <div class="smallstat stat" style="margin-bottom:26px"><div class="v">264</div><div class="l">people, public and professional only</div></div>
      <div class="smallstat stat" style="margin-bottom:26px"><div class="v">236</div><div class="l">organisations</div></div>
