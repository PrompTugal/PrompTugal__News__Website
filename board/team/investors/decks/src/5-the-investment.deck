      <g fill="none" stroke="#006600" stroke-width="2.5" stroke-dasharray="5 4"><rect x="1409" y="188" width="22" height="22"/><rect x="1437" y="188" width="22" height="22"/></g>
      <text x="1420" y="346" text-anchor="middle" font-size="21" font-weight="600" fill="#121317">Another</text><text x="1420" y="374" text-anchor="middle" font-size="21" font-weight="600" fill="#121317">milestone</text><text x="1420" y="400" text-anchor="middle" font-size="20" fill="#3f424a">more vest</text>
      <!-- stage 4 -->
