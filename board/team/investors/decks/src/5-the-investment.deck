      <text x="980" y="346" text-anchor="middle" font-size="21" font-weight="600" fill="#121317">Joins</text><text x="980" y="374" text-anchor="middle" font-size="20" fill="#3f424a">shares granted,</text><text x="980" y="400" text-anchor="middle" font-size="20" fill="#3f424a">not yet vested</text>
      <!-- stage 2 -->
      <circle cx="1200" cy="300" r="13" fill="#f6f3ec" stroke="#006600" stroke-width="5"/>
      <rect x="1161" y="160" width="22" height="22" fill="#006600"/><rect x="1189" y="160" width="22" height="22" fill="#006600"/>
      <g fill="none" stroke="#006600" stroke-width="2.5" stroke-dasharray="5 4"><rect x="1217" y="160" width="22" height="22"/><rect x="1161" y="188" width="22" height="22"/><rect x="1189" y="188" width="22" height="22"/><rect x="1217" y="188" width="22" height="22"/></g>
      <text x="1200" y="346" text-anchor="middle" font-size="21" font-weight="600" fill="#121317">A milestone</text><text x="1200" y="374" text-anchor="middle" font-size="20" fill="#3f424a">some vest</text>
