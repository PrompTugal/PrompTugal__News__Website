    <line x1="190" y1="230" x2="1490" y2="230" stroke="#9d9580" stroke-width="3"/>
    <g stroke="#9d9580" stroke-width="3"><line x1="190" y1="230" x2="190" y2="270"/><line x1="623" y1="230" x2="623" y2="270"/><line x1="1056" y1="230" x2="1056" y2="270"/><line x1="1490" y1="230" x2="1490" y2="270"/></g>
    <rect x="0" y="270" width="380" height="200" fill="#fffdf8" stroke="#006600" stroke-width="3"/>
    <text x="24" y="308" class="mono" font-size="18" fill="#006600" letter-spacing="2">IN PLACE</text>
