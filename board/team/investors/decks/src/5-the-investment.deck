    <text x="457" y="352" class="serif" font-size="32" font-weight="600" fill="#121317">Journalists</text>
    <text x="457" y="392" font-size="21" fill="#3f424a">very technical people,</text>
    <text x="457" y="422" font-size="21" fill="#3f424a">editorial with the agents</text>
    <rect x="866" y="270" width="380" height="200" fill="#fffdf8" stroke="#c52830" stroke-width="3" stroke-dasharray="12 8"/>
