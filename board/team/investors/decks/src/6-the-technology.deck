    <circle cx="1440" cy="440" r="16" fill="#fffdf8" stroke="#121317" stroke-width="3"/><text x="1440" y="486" font-size="22" font-weight="600" fill="#121317" text-anchor="middle">AI agents and models</text>
    <circle cx="1000" cy="440" r="16" fill="#fffdf8" stroke="#1f4fa8" stroke-width="4"/><text x="1000" y="486" font-size="22" font-weight="600" fill="#121317" text-anchor="middle">sgit keys, vaults</text>
    <circle cx="330" cy="440" r="16" fill="#fffdf8" stroke="#c52830" stroke-width="4"/><text x="330" y="486" font-size="22" font-weight="600" fill="#121317" text-anchor="middle">Binding boundaries</text>
