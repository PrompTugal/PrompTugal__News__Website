      <rect x="0" y="0" width="1160" height="86" fill="#ece7db"/>
      <text x="30" y="38" class="serif" font-size="32" font-weight="600" fill="#121317">Open, static, serverless</text><text x="30" y="70" font-size="21" fill="#3f424a">code Apache-2.0, text CC BY 4.0; no back end for readers, no tracking</text>
      <line x1="1160" y1="43" x2="1200" y2="43" stroke="#9d9580" stroke-width="2" stroke-dasharray="6 6"/><text x="1210" y="38" font-size="22" fill="#121317" font-weight="600">Unchanged</text><text x="1210" y="68" font-size="20" fill="#595c64">the floor everything stands on</text>
