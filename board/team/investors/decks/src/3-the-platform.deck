<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>PrompTugal: the platform</title>
<meta name="description" content="What PrompTugal.news is and every feature it runs today, shown on the live site: sourced and signed articles, the graph, Ask, My day, micropayments, the reader's vault, the app, data for agents, the newsroom in the open. Investor deck 3 of 4, November 2026.">
<link rel="stylesheet" href="deck.css">
<style>
/* deck 3 only: annotated screenshots, layered composition, callout lists */
.scr { position: relative; }
.scr img { display: block; width: 100%; }
.pin { position: absolute; width: 50px; height: 50px; margin: -25px 0 0 -25px; border-radius: 50%; background: var(--red); color: #fff; font: 600 28px/50px var(--serif); text-align: center; box-shadow: 0 0 0 7px rgba(197,40,48,.22), 0 6px 14px rgba(18,19,23,.3); z-index: 3; }
.pin.g { background: var(--green); box-shadow: 0 0 0 7px rgba(0,102,0,.22), 0 6px 14px rgba(18,19,23,.3); }
.hot { position: absolute; border: 4px solid var(--red); border-radius: 8px; z-index: 2; background: rgba(197,40,48,.06); }
.hot.g { border-color: var(--green); background: rgba(0,102,0,.06); }
ol.co { list-style: none; counter-reset: co; margin-top: 8px; }
ol.co li { counter-increment: co; position: relative; padding-left: 70px; margin: 0 0 22px; font: 400 23px/1.4 var(--sans); color: var(--ink-2); }
ol.co li::before { content: counter(co); position: absolute; left: 0; top: -2px; width: 46px; height: 46px; border-radius: 50%; background: var(--red); color: #fff; font: 600 26px/46px var(--serif); text-align: center; }
ol.co.g li::before { background: var(--green); }
ol.co li b { color: var(--ink); display: block; font: 600 26px/1.25 var(--serif); margin-bottom: 2px; }
.slide.ink ol.co li { color: #c8c4ba; } .slide.ink ol.co li b { color: var(--paper); }
.stage { position: relative; }
.abs { position: absolute; }
.shot.sm .bar { height: 34px; font-size: 15px; }
.badge { display: inline-block; font: 500 18px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; background: var(--red); color: #fff; padding: 10px 14px; }
.badge.g { background: var(--green); } .badge.k { background: var(--ink); }
.note { background: var(--panel); border-left: 8px solid var(--green); padding: 22px 26px; font: 400 23px/1.42 var(--sans); color: var(--ink-2); box-shadow: 0 20px 40px -20px rgba(18,19,23,.3); }
.note b { color: var(--ink); }
.note.r { border-left-color: var(--red); }
.aud { background: var(--panel); border: 1px solid var(--hair); border-top: 8px solid var(--green); padding: 28px 26px 30px; }
.aud .n { font: 500 19px/1 var(--mono); letter-spacing: .12em; color: var(--green); margin-bottom: 14px; }
.aud h3 { font-size: 32px; margin-bottom: 10px; } .aud p { font: 400 22px/1.42 var(--sans); color: var(--ink-2); }
.bignum { font: 600 120px/1 var(--serif); letter-spacing: -.03em; }
.sgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 34px 40px; }
.sgrid .stat .v { font-size: 84px; }
.urlrow { font: 500 36px/1.3 var(--mono); color: var(--paper); }
.urlrow span { color: #8fd18f; }
</style></head>
<body><main class="deck">

<!-- 1 · cover -->
<section class="slide ink" style="padding:0">
  <div class="head"><span><b>Investors</b> · deck 3 of 4</span><span>v1.0 · 7 November 2026</span></div>
  <div class="abs" style="left:120px;top:190px;width:760px">
    <div class="kicker">PrompTugal: the platform</div>
    <h1 style="font-size:100px">Not a mock-up. The product, live.</h1>
    <p class="lead" style="font-size:31px">Sourced and signed news, the summit's days and your own day, an assistant, a vault that is yours, pay after the value, an app, and data made for agents. Built by people and AI agents, in public.</p>
    <div style="margin-top:44px"><span class="tag" style="color:#8fd18f">promptugal.news</span><span class="tag" style="color:#ff9a9e">ios.app.promptugal.news</span></div>
  </div>
  <div class="shot abs" style="left:930px;top:150px;width:880px;transform:rotate(-1.2deg)"><div class="bar"><i></i><i></i><i></i><span>promptugal.news/articles/brazil-on-the-stages.html</span></div><img src="shots/p3-article.jpg" alt="A PrompTugal.news article"></div>
  <div class="phone abs" style="left:1190px;top:430px;width:240px;transform:rotate(-3deg)"><img src="shots/p3-m-ask.jpg" alt="Ask the newsroom on a phone"></div>
  <div class="phone abs" style="left:1520px;top:400px;width:250px;transform:rotate(2.5deg)"><img src="shots/p3-m-myday.jpg" alt="My day on a phone"></div>
  <div class="foot"><span class="wordmark">Promp<span class="t">T</span><span class="u">ugal</span><i>.news</i></span><span>The platform</span></div>
</section>

<!-- 2 · what it is -->
<section class="slide">
  <div class="head"><span><b>What it is</b></span><span>02</span></div>
  <div class="kicker">PrompTugal in one slide</div>
  <h2>A newsroom of people and AI agents, and the platform it runs on.</h2>
  <div style="margin-top:46px;background:var(--ink);color:var(--paper);padding:30px 40px;display:grid;grid-template-columns:auto 1fr;gap:40px;align-items:center">
    <div style="font:600 40px/1.1 var(--serif)">Promp<span style="color:#ff7a7f">T</span><span style="color:#8fd18f">ugal</span><i style="font-weight:400;font-size:.8em">.news</i></div>
    <div style="font:400 25px/1.45 var(--sans);color:#c8c4ba">Technology and AI, in context, from Portugal for Europe. <b style="color:var(--paper)">Every fact sourced and dated, every article signed,</b> no reader tracked. First edition: Web Summit Lisbon, 9 to 12 November 2026.</div>
  </div>
  <svg viewBox="0 0 1680 46" width="1680" height="46" style="display:block"><g stroke="#006600" stroke-width="3" fill="none"><path d="M168 0 V40"/><path d="M504 0 V40"/><path d="M840 0 V40"/><path d="M1176 0 V40"/><path d="M1512 0 V40"/></g><g fill="#006600"><path d="M160 32 L168 46 L176 32z"/><path d="M496 32 L504 46 L512 32z"/><path d="M832 32 L840 46 L848 32z"/><path d="M1168 32 L1176 46 L1184 32z"/><path d="M1504 32 L1512 46 L1520 32z"/></g></svg>
  <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:24px">
    <div class="aud"><div class="n">READERS</div><h3>News you can check</h3><p>Each claim links to its source and the date it was read. Pay pennies, after the value.</p></div>
    <div class="aud"><div class="n">ATTENDEES</div><h3>The summit, and your day</h3><p>Every day of the event, your own picks, on the web and in the app, kept on your device.</p></div>
    <div class="aud"><div class="n">TEAMS</div><h3>A version for your team</h3><p>Who goes where, briefings before and after each talk. Being built next.</p></div>
    <div class="aud" style="border-top-color:var(--red)"><div class="n" style="color:var(--red)">PUBLISHERS, EVENTS</div><h3>The platform, deployed</h3><p>For another event or newsroom, as a team, or under licence on your own terms.</p></div>
    <div class="aud" style="border-top-color:var(--cobalt)"><div class="n" style="color:var(--cobalt)">AI AGENTS</div><h3>Data made for them</h3><p>A markdown twin of every page, llms.txt and JSON: ready to use, every fact sourced.</p></div>
  </div>
  <div class="foot"><span class="wordmark">Promp<span class="t">T</span><span class="u">ugal</span><i>.news</i></span><span>The platform</span></div>
</section>

<!-- 3 · the map -->
<section class="slide">
  <div class="head"><span><b>The map</b></span><span>03</span></div>
  <div class="kicker">How it fits together</div>
  <h2 style="font-size:64px">Four layers. No back end ever sees a reader.</h2>
  <svg viewBox="0 0 1680 640" width="1680" height="640" style="margin-top:30px">
    <defs><marker id="m3" markerWidth="12" markerHeight="12" refX="10" refY="6" orient="auto"><path d="M0,0 L12,6 L0,12 z" fill="#006600"/></marker>
      <marker id="m3k" markerWidth="12" markerHeight="12" refX="10" refY="6" orient="auto"><path d="M0,0 L12,6 L0,12 z" fill="#3f424a"/></marker></defs>
    <!-- labels -->
    <g class="mono" font-size="19" letter-spacing="2" fill="#595c64">
      <text x="0" y="58">1 · WHAT</text><text x="0" y="82">READERS USE</text>
      <text x="0" y="300">2 · THE</text><text x="0" y="324">NEWSROOM</text>
      <text x="0" y="520">3 · THE DATA</text><text x="0" y="544">ONE GRAPH</text>
    </g>
    <!-- layer 1 -->
    <g font-size="22">
      <rect x="200" y="18" width="200" height="110" fill="#fffdf8" stroke="#121317" stroke-width="2"/><text x="300" y="64" text-anchor="middle" class="serif" font-size="27" font-weight="600">The site</text><text x="300" y="96" text-anchor="middle" fill="#595c64" font-size="19">news, companies</text>
      <rect x="418" y="18" width="200" height="110" fill="#fffdf8" stroke="#121317" stroke-width="2"/><text x="518" y="64" text-anchor="middle" class="serif" font-size="27" font-weight="600">The app</text><text x="518" y="96" text-anchor="middle" fill="#595c64" font-size="19">iPhone and iPad</text>
      <rect x="636" y="18" width="200" height="110" fill="#fffdf8" stroke="#121317" stroke-width="2"/><text x="736" y="64" text-anchor="middle" class="serif" font-size="27" font-weight="600">Search, Ask</text><text x="736" y="96" text-anchor="middle" fill="#595c64" font-size="19">your own model key</text>
      <rect x="854" y="18" width="200" height="110" fill="#fffdf8" stroke="#121317" stroke-width="2"/><text x="954" y="64" text-anchor="middle" class="serif" font-size="27" font-weight="600">My day</text><text x="954" y="96" text-anchor="middle" fill="#595c64" font-size="19">the summit's days</text>
      <rect x="1072" y="18" width="200" height="110" fill="#fffdf8" stroke="#121317" stroke-width="2"/><text x="1172" y="64" text-anchor="middle" class="serif" font-size="27" font-weight="600">Account</text><text x="1172" y="96" text-anchor="middle" fill="#595c64" font-size="19">meter, top-up</text>
    </g>
    <!-- vault column -->
    <rect x="1340" y="0" width="340" height="640" fill="#e2eedf"/>
    <text x="1510" y="40" text-anchor="middle" class="mono" font-size="19" letter-spacing="2" fill="#006600">4 · ON THE READER'S DEVICE</text>
    <rect x="1370" y="62" width="280" height="150" fill="#006600"/>
    <text x="1510" y="112" text-anchor="middle" class="serif" font-size="30" font-weight="600" fill="#fff">Your vault</text>
    <text x="1510" y="146" text-anchor="middle" font-size="20" fill="#e2eedf">opened with a passkey,</text>
    <text x="1510" y="174" text-anchor="middle" font-size="20" fill="#e2eedf">encrypted before it leaves</text>
    <line x1="1276" y1="73" x2="1364" y2="120" stroke="#006600" stroke-width="4" marker-end="url(#m3)"/>
    <g font-size="21" fill="#121317">
      <text x="1390" y="270">your picks and reads</text>
      <text x="1390" y="306">your balance, receipts</text>
      <text x="1390" y="342">your model key</text>
      <text x="1390" y="378">your keys</text>
      <text x="1390" y="438" font-weight="600">and your interests meet</text>
      <text x="1390" y="468" font-weight="600">the content graph here,</text>
      <text x="1390" y="498" font-weight="600">not on our servers</text>
    </g>
    <path d="M1370 530 C 1300 560, 1240 560, 1210 545" stroke="#006600" stroke-width="3" fill="none" stroke-dasharray="8 6" marker-end="url(#m3)"/>
    <!-- the line -->
    <line x1="200" y1="176" x2="1320" y2="176" stroke="#c52830" stroke-width="4" stroke-dasharray="14 10"/>
    <rect x="300" y="157" width="920" height="38" fill="#f6f3ec"/>
    <text x="760" y="184" text-anchor="middle" font-size="22" font-weight="600" fill="#c52830">NO BACK END THAT SEES READERS · no IP, no cookie, no profile · vault: ciphertext only</text>
    <!-- layer 2 -->
    <g>
      <rect x="200" y="236" width="230" height="130" fill="#fffdf8" stroke="#006600" stroke-width="3"/><text x="315" y="286" text-anchor="middle" class="serif" font-size="27" font-weight="600">AI agents</text><text x="315" y="318" text-anchor="middle" font-size="19" fill="#595c64">about 25 named roles</text><text x="315" y="344" text-anchor="middle" font-size="19" fill="#595c64">and a named human</text>
      <line x1="430" y1="301" x2="490" y2="301" stroke="#006600" stroke-width="4" marker-end="url(#m3)"/>
      <rect x="500" y="236" width="230" height="130" fill="#121317"/><text x="615" y="286" text-anchor="middle" class="serif" font-size="27" font-weight="600" fill="#f6f3ec">The gate</text><text x="615" y="318" text-anchor="middle" font-size="19" fill="#c8c4ba">automatic checks:</text><text x="615" y="344" text-anchor="middle" font-size="19" fill="#c8c4ba">sources, signatures</text>
      <line x1="730" y1="301" x2="790" y2="301" stroke="#006600" stroke-width="4" marker-end="url(#m3)"/>
      <rect x="800" y="236" width="230" height="130" fill="#006600"/><text x="915" y="286" text-anchor="middle" class="serif" font-size="27" font-weight="600" fill="#fff">A release</text><text x="915" y="318" text-anchor="middle" font-size="19" fill="#e2eedf">numbered, deployed,</text><text x="915" y="344" text-anchor="middle" font-size="19" fill="#e2eedf">many a day</text>
      <line x1="1030" y1="301" x2="1090" y2="301" stroke="#006600" stroke-width="4" marker-end="url(#m3)"/>
      <rect x="1100" y="236" width="210" height="130" fill="#fffdf8" stroke="#121317" stroke-width="2"/><text x="1205" y="282" text-anchor="middle" class="serif" font-size="25" font-weight="600">Static output</text><text x="1205" y="314" text-anchor="middle" font-size="19" fill="#595c64">pages, twins,</text><text x="1205" y="340" text-anchor="middle" font-size="19" fill="#595c64">llms.txt, JSON</text>
      <line x1="1205" y1="236" x2="1205" y2="200" stroke="#3f424a" stroke-width="3" marker-end="url(#m3k)"/>
    </g>
    <!-- layer 3 -->
    <rect x="200" y="420" width="1110" height="210" fill="#fffdf8" stroke="#d9d2c1"/>
    <line x1="315" y1="420" x2="315" y2="376" stroke="#3f424a" stroke-width="3" marker-end="url(#m3k)"/>
    <text x="230" y="466" class="serif" font-size="30" font-weight="600">A semantic graph</text>
    <text x="230" y="498" font-size="20" fill="#595c64">every fact with its source</text>
    <text x="230" y="524" font-size="20" fill="#595c64">and the date it was read</text>
    <g font-size="21">
      <rect x="230" y="556" width="150" height="44" fill="#e2eedf"/><text x="305" y="585" text-anchor="middle"><tspan font-weight="600">120</tspan> companies</text>
      <rect x="392" y="556" width="130" height="44" fill="#e2eedf"/><text x="457" y="585" text-anchor="middle"><tspan font-weight="600">264</tspan> people</text>
      <rect x="534" y="556" width="130" height="44" fill="#e2eedf"/><text x="599" y="585" text-anchor="middle"><tspan font-weight="600">240</tspan> events</text>
    </g>
    <g font-size="21">
      <rect x="230" y="608" width="0" height="0"/>
    </g>
    <!-- mini graph -->
    <g stroke="#9d9580" stroke-width="2">
      <line x1="760" y1="520" x2="880" y2="470"/><line x1="760" y1="520" x2="860" y2="590"/><line x1="880" y1="470" x2="1010" y2="500"/><line x1="860" y1="590" x2="1010" y2="500"/><line x1="1010" y1="500" x2="1130" y2="455"/><line x1="1010" y1="500" x2="1150" y2="580"/><line x1="1130" y1="455" x2="1250" y2="510"/><line x1="1150" y1="580" x2="1250" y2="510"/><line x1="880" y1="470" x2="980" y2="600"/>
    </g>
    <g font-size="19" fill="#3f424a">
      <circle cx="760" cy="520" r="15" fill="#006600"/><text x="760" y="556" text-anchor="middle">company</text>
      <circle cx="880" cy="470" r="13" fill="#fffdf8" stroke="#121317" stroke-width="3"/><text x="880" y="446" text-anchor="middle">person</text>
      <path d="M1010 482 L1028 512 L992 512z" fill="#c52830"/><text x="1010" y="540" text-anchor="middle">event</text>
