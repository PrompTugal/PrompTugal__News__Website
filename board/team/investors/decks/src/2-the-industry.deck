      <rect x="370" y="330" width="320" height="104" fill="#fffdf8" stroke="#121317" stroke-width="3"/><text x="388" y="360" class="mono" font-size="18" fill="#121317" letter-spacing="1">SOURCE</text><text x="388" y="392" font-size="22" font-weight="600" fill="#121317">The contractor's update</text><text x="388" y="420" font-size="20" fill="#3f424a">the new date</text>
      <rect x="740" y="330" width="320" height="104" fill="#fffdf8" stroke="#c52830" stroke-width="3"/><text x="758" y="360" class="mono" font-size="18" fill="#c52830" letter-spacing="1">SOURCE</text><text x="758" y="392" font-size="22" font-weight="600" fill="#121317">A post online</text><text x="758" y="420" font-size="20" fill="#3f424a">says: next week</text>
      <line x1="160" y1="330" x2="190" y2="262" stroke="#006600" stroke-width="4" marker-end="url(#pg)"/>
      <text x="196" y="300" text-anchor="start" class="mono" font-size="18" fill="#006600" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">supports</text>
