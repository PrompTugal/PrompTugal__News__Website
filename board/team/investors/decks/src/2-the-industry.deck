    <circle cx="930" cy="40" r="17" fill="#121317"/><text x="958" y="48" font-size="24" font-weight="600" fill="#121317" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">A reader</text>
    <circle cx="800" cy="120" r="15" fill="#006600"/><text x="826" y="128" font-size="24" font-weight="600" fill="#006600" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">needs accurate information, kept current, that saves time</text>
    <line x1="539" y1="230" x2="760" y2="230" stroke="#006600" stroke-width="4" stroke-dasharray="10 8" marker-end="url(#mvg)"/><circle cx="520" cy="230" r="15" fill="#fffdf8" stroke="#006600" stroke-width="5"/><text x="520" y="272" text-anchor="middle" font-size="22" font-weight="600" fill="#121317" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">Trust</text>
    <line x1="639" y1="340" x2="860" y2="340" stroke="#006600" stroke-width="4" stroke-dasharray="10 8" marker-end="url(#mvg)"/><circle cx="620" cy="340" r="15" fill="#fffdf8" stroke="#006600" stroke-width="5"/><text x="620" y="382" text-anchor="middle" font-size="22" font-weight="600" fill="#121317" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">Maintained claims</text>
    <line x1="249" y1="400" x2="450" y2="400" stroke="#006600" stroke-width="4" stroke-dasharray="10 8" marker-end="url(#mvg)"/><circle cx="230" cy="400" r="15" fill="#fffdf8" stroke="#006600" stroke-width="5"/><text x="230" y="442" text-anchor="middle" font-size="22" font-weight="600" fill="#121317" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">Provenance</text><text x="230" y="468" text-anchor="middle" font-size="19" class="mono" fill="#006600" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">sources, evidence, signatures</text>
    <line x1="319" y1="505" x2="520" y2="505" stroke="#006600" stroke-width="4" stroke-dasharray="10 8" marker-end="url(#mvg)"/><circle cx="300" cy="505" r="15" fill="#fffdf8" stroke="#006600" stroke-width="5"/><text x="300" y="547" text-anchor="middle" font-size="22" font-weight="600" fill="#121317" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">An agentic newsroom</text>
