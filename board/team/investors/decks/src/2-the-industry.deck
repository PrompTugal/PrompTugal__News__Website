    <circle cx="1450" cy="430" r="15" fill="#fffdf8" stroke="#c52830" stroke-width="5"/><text x="1450" y="472" text-anchor="middle" font-size="22" font-weight="600" fill="#121317" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">Advertising</text><text x="1450" y="498" text-anchor="middle" font-size="19" class="mono" fill="#c52830" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">attention, sold</text>
