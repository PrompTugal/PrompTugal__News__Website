    <div style="font:400 28px/1.3 var(--sans);color:#595c64;text-decoration:line-through;text-decoration-color:#c52830;text-decoration-thickness:2px">the reader's attention</div>
    <div style="font:600 40px/1 var(--serif);color:#006600">&#8594;</div>
    <div style="font:600 30px/1.3 var(--sans);color:#121317">time, the experience, trust</div>
  </div><div style="display:grid;grid-template-columns:300px 1fr 70px 1fr;align-items:center;border-bottom:1px solid #d9d2c1;padding:17px 0">
    <div style="font:500 19px/1.2 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:#595c64">The unit</div>
    <div style="font:400 28px/1.3 var(--sans);color:#595c64;text-decoration:line-through;text-decoration-color:#c52830;text-decoration-thickness:2px">the article, written once</div>
    <div style="font:600 40px/1 var(--serif);color:#006600">&#8594;</div>
    <div style="font:600 30px/1.3 var(--sans);color:#121317">the maintained claim, kept current</div>
  </div><div style="display:grid;grid-template-columns:300px 1fr 70px 1fr;align-items:center;border-bottom:1px solid #d9d2c1;padding:17px 0">
    <div style="font:500 19px/1.2 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:#595c64">When people pay</div>
    <div style="font:400 28px/1.3 var(--sans);color:#595c64;text-decoration:line-through;text-decoration-color:#c52830;text-decoration-thickness:2px">before, for a bundle</div>
    <div style="font:600 40px/1 var(--serif);color:#006600">&#8594;</div>
