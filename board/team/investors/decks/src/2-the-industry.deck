<!-- 4 · the wrong direction -->
<section class="slide">
  <div class="head"><span><b>The wrong direction</b></span><span>04</span></div>
  <div class="kicker red">What the industry is doing about it</div>
  <h2 style="font-size:68px">Its answer is more of what drives readers away.</h2>
  <div class="cols w60 center" style="margin-top:30px;gap:70px">
    <svg viewBox="0 0 880 640" width="880" height="640">
      <defs><marker id="ar" markerUnits="userSpaceOnUse" viewBox="0 0 14 14" markerWidth="24" markerHeight="24" refX="11" refY="7" orient="auto"><path d="M0,0 L14,7 L0,14 z" fill="#c52830"/></marker></defs>
      <circle cx="440" cy="320" r="232" fill="none" stroke="#d9d2c1" stroke-width="2" stroke-dasharray="6 8"/>
      <path d="M612,108 A232,232 0 0 1 668,238" fill="none" stroke="#c52830" stroke-width="5" marker-end="url(#ar)"/>
      <path d="M668,402 A232,232 0 0 1 612,532" fill="none" stroke="#c52830" stroke-width="5" marker-end="url(#ar)"/>
      <path d="M268,532 A232,232 0 0 1 212,402" fill="none" stroke="#c52830" stroke-width="5" marker-end="url(#ar)"/>
      <path d="M212,238 A232,232 0 0 1 268,108" fill="none" stroke="#c52830" stroke-width="5" marker-end="url(#ar)"/>
      <rect x="300" y="36" width="280" height="104" fill="#f8e4df" stroke="#c52830" stroke-width="3"/><text x="440" y="80" text-anchor="middle" font-size="25" font-weight="600" fill="#121317">Fewer pay</text><text x="440" y="114" text-anchor="middle" font-size="25" fill="#121317">for the article</text>
      <rect x="595" y="268" width="280" height="104" fill="#f8e4df" stroke="#c52830" stroke-width="3"/><text x="735" y="312" text-anchor="middle" font-size="25" font-weight="600" fill="#121317">More paywalls,</text><text x="735" y="346" text-anchor="middle" font-size="25" fill="#121317">more subscriptions</text>
      <rect x="300" y="500" width="280" height="104" fill="#f8e4df" stroke="#c52830" stroke-width="3"/><text x="440" y="544" text-anchor="middle" font-size="25" font-weight="600" fill="#121317">More tracking, to</text><text x="440" y="578" text-anchor="middle" font-size="25" fill="#121317">personalise and sell</text>
      <rect x="5" y="268" width="280" height="104" fill="#f8e4df" stroke="#c52830" stroke-width="3"/><text x="145" y="312" text-anchor="middle" font-size="25" font-weight="600" fill="#121317">Less trust,</text><text x="145" y="346" text-anchor="middle" font-size="25" fill="#121317">more avoidance</text>
      <text x="440" y="310" text-anchor="middle" class="serif" font-size="44" font-weight="600" fill="#121317">The loop</text>
      <text x="440" y="350" text-anchor="middle" font-size="22" fill="#595c64">each turn costs readers</text>
    </svg>
    <div>
      <div style="border-left:8px solid #c52830;padding:4px 0 4px 30px;margin-bottom:40px">
        <p style="font:italic 400 38px/1.25 var(--serif)">"You pay 100% for the 10% you actually wanted."</p>
        <div class="src" style="margin-top:12px">on subscriptions</div>
      </div>
      <div style="border-left:8px solid #c52830;padding:4px 0 4px 30px;margin-bottom:40px">
        <p style="font:italic 400 38px/1.25 var(--serif)">"The industry's answer to both is more subscriptions and more personalisation."</p>
        <div class="src" style="margin-top:12px">on falling trust and falling revenue</div>
      </div>
      <div style="border-left:8px solid #121317;padding:4px 0 4px 30px">
        <p style="font:italic 400 38px/1.25 var(--serif)">"The news industry sells the one thing whose price is going to zero, the article."</p>
      </div>
      <div class="src" style="margin-top:26px">Dinis Cruz, "The future of news is the story vault, not the paywall", newsroom.sgit.ai, 22 Sep 2026.</div>
    </div>
  </div>
  <div class="foot"><span class="wordmark">Promp<span class="t">T</span><span class="u">ugal</span><i>.news</i></span><span>The industry</span></div>
</section>
<!-- 5 · the evolution map -->
<section class="slide">
  <div class="head"><span><b>Where the value is moving</b></span><span>05</span></div>
  <div class="kicker">A map of the news business, as it evolves</div>
  <h2 style="font-size:60px;max-width:1680px">The industry defends what is turning into a commodity.</h2>
  <svg viewBox="0 0 1680 604" width="1680" height="604" style="margin-top:34px">
    <defs>
      <marker id="mvg" markerUnits="userSpaceOnUse" viewBox="0 0 14 14" markerWidth="24" markerHeight="24" refX="10" refY="7" orient="auto"><path d="M0,0 L14,7 L0,14 z" fill="#006600"/></marker>
      <marker id="mvr" markerUnits="userSpaceOnUse" viewBox="0 0 14 14" markerWidth="24" markerHeight="24" refX="10" refY="7" orient="auto"><path d="M0,0 L14,7 L0,14 z" fill="#c52830"/></marker>
      <marker id="ax" markerUnits="userSpaceOnUse" viewBox="0 0 14 14" markerWidth="24" markerHeight="24" refX="7" refY="7" orient="auto"><path d="M0,0 L14,7 L0,14 z" fill="#121317"/></marker>
    </defs>
    <rect x="60" y="0" width="800" height="560" fill="#e2eedf" opacity=".45"/>
    <rect x="1260" y="0" width="400" height="560" fill="#f8e4df" opacity=".5"/>
    <line x1="460" y1="0" x2="460" y2="560" stroke="#d9d2c1" stroke-width="2" stroke-dasharray="6 6"/><line x1="860" y1="0" x2="860" y2="560" stroke="#d9d2c1" stroke-width="2" stroke-dasharray="6 6"/><line x1="1260" y1="0" x2="1260" y2="560" stroke="#d9d2c1" stroke-width="2" stroke-dasharray="6 6"/>
    <line x1="60" y1="560" x2="1670" y2="560" stroke="#121317" stroke-width="3" marker-end="url(#ax)"/>
    <line x1="30" y1="560" x2="30" y2="6" stroke="#121317" stroke-width="3" marker-end="url(#ax)"/>
    <text transform="translate(20,290) rotate(-90)" text-anchor="middle" class="mono" font-size="18" fill="#595c64" letter-spacing="1">VISIBLE TO THE READER</text>
