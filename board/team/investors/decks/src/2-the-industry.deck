      <rect x="370" y="510" width="320" height="104" fill="#fffdf8" stroke="#1f4fa8" stroke-width="3"/><text x="388" y="540" class="mono" font-size="18" fill="#1f4fa8" letter-spacing="1">EVIDENCE</text><text x="388" y="572" font-size="22" font-weight="600" fill="#121317">Page fetched, dated</text><text x="388" y="600" font-size="20" fill="#3f424a">and hashed</text>
      <rect x="740" y="510" width="320" height="104" fill="#fffdf8" stroke="#1f4fa8" stroke-width="3"/><text x="758" y="540" class="mono" font-size="18" fill="#1f4fa8" letter-spacing="1">EVIDENCE</text><text x="758" y="572" font-size="22" font-weight="600" fill="#121317">Page fetched, dated</text><text x="758" y="600" font-size="20" fill="#3f424a">and hashed</text>
      <line x1="160" y1="510" x2="160" y2="442" stroke="#1f4fa8" stroke-width="3" marker-end="url(#pk)"/>
      <line x1="530" y1="510" x2="530" y2="442" stroke="#1f4fa8" stroke-width="3" marker-end="url(#pk)"/>
      <line x1="900" y1="510" x2="900" y2="442" stroke="#1f4fa8" stroke-width="3" marker-end="url(#pk)"/>
      <text x="172" y="482" text-anchor="start" class="mono" font-size="18" fill="#1f4fa8" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">evidenced by</text>
    </svg>
    <div>
      <p style="font:italic 400 46px/1.18 var(--serif);color:#121317">"Trust through provenance, provenance via evidence."</p>
      <div class="src" style="margin-top:12px">Dinis Cruz, newsroom.sgit.ai</div>
      <ul class="ticks" style="margin-top:36px">
        <li><b>Claims</b> carry their status: current, contradicted, superseded.</li>
        <li><b>Sources</b> are named, so they can be checked, and paid.</li>
        <li><b>Evidence</b> is the page as fetched, with its date and a hash.</li>
      </ul>
      <p style="font:600 28px/1.35 var(--serif);color:#c52830;margin-top:20px">"A page that cannot name its source cannot pay it."</p>
    </div>
  </div>
  <div class="foot"><span class="wordmark">Promp<span class="t">T</span><span class="u">ugal</span><i>.news</i></span><span>The industry · illustration after the bridge simulation</span></div>
</section>
<!-- 10 · privacy -->
<section class="slide">
  <div class="head"><span><b>Privacy by architecture</b></span><span>10</span></div>
  <div class="kicker">We sell time, the experience and trust</div>
  <h2 style="font-size:66px">Never the reader. Not by policy: by design.</h2>
  <div class="cols" style="margin-top:34px;gap:50px">
    <div style="background:#ece7db;padding:26px 30px 20px">
      <div class="mono" style="font:500 20px/1 var(--mono);letter-spacing:.12em;color:#c52830">THE USUAL MODEL</div>
      <svg viewBox="0 0 735 560" width="735" height="560" style="margin-top:14px">
        <defs><marker id="qr" markerUnits="userSpaceOnUse" viewBox="0 0 12 12" markerWidth="22" markerHeight="22" refX="10" refY="6" orient="auto"><path d="M0,0 L12,6 L0,12 z" fill="#c52830"/></marker></defs>
        <rect x="0" y="40" width="200" height="110" fill="#fffdf8" stroke="#121317" stroke-width="3"/><text x="100.0" y="89.0" text-anchor="middle" font-size="22" font-weight="600" fill="#121317">The reader</text><text x="100.0" y="117.0" text-anchor="middle" font-size="19" fill="#121317" opacity=".85">on a phone</text>
        <rect x="290" y="40" width="260" height="110" fill="#fffdf8" stroke="#121317" stroke-width="3"/><text x="420.0" y="89.0" text-anchor="middle" font-size="22" font-weight="600" fill="#121317">The publisher's</text><text x="420.0" y="117.0" text-anchor="middle" font-size="19" fill="#121317" opacity=".85">servers, logs</text>
        <line x1="200" y1="95" x2="282" y2="95" stroke="#c52830" stroke-width="4" marker-end="url(#qr)"/>
        <rect x="0" y="250" width="220" height="96" fill="#f8e4df" stroke="#c52830" stroke-width="3"/><text x="110.0" y="292.0" text-anchor="middle" font-size="22" font-weight="600" fill="#121317">Cookies</text><text x="110.0" y="320.0" text-anchor="middle" font-size="19" fill="#121317" opacity=".85">and trackers</text>
        <rect x="257" y="250" width="220" height="96" fill="#f8e4df" stroke="#c52830" stroke-width="3"/><text x="367.0" y="292.0" text-anchor="middle" font-size="22" font-weight="600" fill="#121317">Ad tech</text><text x="367.0" y="320.0" text-anchor="middle" font-size="19" fill="#121317" opacity=".85">auctions</text>
        <rect x="514" y="250" width="220" height="96" fill="#f8e4df" stroke="#c52830" stroke-width="3"/><text x="624.0" y="292.0" text-anchor="middle" font-size="22" font-weight="600" fill="#121317">Data</text><text x="624.0" y="320.0" text-anchor="middle" font-size="19" fill="#121317" opacity=".85">brokers</text>
        <line x1="380" y1="150" x2="120" y2="244" stroke="#c52830" stroke-width="3" marker-end="url(#qr)"/>
        <line x1="420" y1="150" x2="367" y2="244" stroke="#c52830" stroke-width="3" marker-end="url(#qr)"/>
        <line x1="460" y1="150" x2="620" y2="244" stroke="#c52830" stroke-width="3" marker-end="url(#qr)"/>
        <line x1="100" y1="150" x2="100" y2="244" stroke="#c52830" stroke-width="3" stroke-dasharray="7 6" marker-end="url(#qr)"/>
        <line x1="110" y1="346" x2="320" y2="430" stroke="#c52830" stroke-width="3" marker-end="url(#qr)"/>
        <line x1="367" y1="346" x2="367" y2="424" stroke="#c52830" stroke-width="3" marker-end="url(#qr)"/>
        <line x1="624" y1="346" x2="414" y2="430" stroke="#c52830" stroke-width="3" marker-end="url(#qr)"/>
        <rect x="157" y="432" width="420" height="100" fill="#c52830" stroke="#c52830" stroke-width="3"/><text x="367.0" y="476.0" text-anchor="middle" font-size="22" font-weight="600" fill="#fff">A profile of the reader</text><text x="367.0" y="504.0" text-anchor="middle" font-size="19" fill="#fff" opacity=".85">built, kept and sold</text>
      </svg>
    </div>
    <div style="background:#fffdf8;border:3px solid #006600;padding:26px 30px 20px">
      <div class="mono" style="font:500 20px/1 var(--mono);letter-spacing:.12em;color:#006600">PROMPTUGAL</div>
      <svg viewBox="0 0 735 560" width="735" height="560" style="margin-top:14px">
        <defs><marker id="qg" markerUnits="userSpaceOnUse" viewBox="0 0 12 12" markerWidth="22" markerHeight="22" refX="10" refY="6" orient="auto"><path d="M0,0 L12,6 L0,12 z" fill="#006600"/></marker><marker id="qgs" markerUnits="userSpaceOnUse" viewBox="0 0 12 12" markerWidth="22" markerHeight="22" refX="2" refY="6" orient="auto"><path d="M12,0 L0,6 L12,12 z" fill="#006600"/></marker></defs>
        <rect x="0" y="0" width="735" height="84" fill="#e2eedf" stroke="#006600" stroke-width="3"/><text x="367.5" y="36.0" text-anchor="middle" font-size="22" font-weight="600" fill="#121317">Static pages, served as files</text><text x="367.5" y="64.0" text-anchor="middle" font-size="19" fill="#121317" opacity=".85">no back end that sees readers: no IP kept, no cookie</text>
        <line x1="367" y1="84" x2="367" y2="124" stroke="#006600" stroke-width="4" marker-end="url(#qg)"/>
