        <rect x="377" y="186" width="334" height="92" fill="#fffdf8" stroke="#121317" stroke-width="3"/><text x="544.0" y="226.0" text-anchor="middle" font-size="22" font-weight="600" fill="#121317">My day, reading meter</text><text x="544.0" y="254.0" text-anchor="middle" font-size="19" fill="#121317" opacity=".85">kept in the browser</text>
        <rect x="24" y="292" width="334" height="92" fill="#fffdf8" stroke="#121317" stroke-width="3"/><text x="191.0" y="332.0" text-anchor="middle" font-size="22" font-weight="600" fill="#121317">Ask the newsroom</text><text x="191.0" y="360.0" text-anchor="middle" font-size="19" fill="#121317" opacity=".85">with the reader's own key</text>
        <rect x="377" y="292" width="334" height="92" fill="#fffdf8" stroke="#121317" stroke-width="3"/><text x="544.0" y="332.0" text-anchor="middle" font-size="22" font-weight="600" fill="#121317">Sign-in</text><text x="544.0" y="360.0" text-anchor="middle" font-size="19" fill="#121317" opacity=".85">with keys, a passkey</text>
        <line x1="367" y1="412" x2="367" y2="440" stroke="#006600" stroke-width="4" marker-start="url(#qgs)" marker-end="url(#qg)"/>
        <rect x="117" y="452" width="500" height="92" fill="#006600" stroke="#006600" stroke-width="3"/><text x="367.0" y="492.0" text-anchor="middle" font-size="22" font-weight="600" fill="#fff">The reader's vault</text><text x="367.0" y="520.0" text-anchor="middle" font-size="19" fill="#fff" opacity=".85">encrypted before it leaves; only they can open it</text>
