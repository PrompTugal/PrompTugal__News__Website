110" fill="#006600" opacity=".85"/><rect x="1384.1" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1411.9" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1439.8" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1467.7" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1495.6" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1523.5" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1551.4" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1579.3" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1607.2" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1635.1" y="230" width="21.9" height="110" fill="#006600" opacity=".85"/><rect x="1635.1" y="70" width="21.9" height="160" fill="#c52830"/>
    <line x1="70" y1="342" x2="1660" y2="342" stroke="#121317" stroke-width="3"/>
    <text x="83.9" y="372" text-anchor="middle" class="mono" font-size="18" fill="#595c64">1</text><text x="335.0" y="372" text-anchor="middle" class="mono" font-size="18" fill="#595c64">10</text><text x="613.9" y="372" text-anchor="middle" class="mono" font-size="18" fill="#595c64">20</text><text x="892.9" y="372" text-anchor="middle" class="mono" font-size="18" fill="#595c64">30</text><text x="1171.8" y="372" text-anchor="middle" class="mono" font-size="18" fill="#595c64">40</text><text x="1450.8" y="372" text-anchor="middle" class="mono" font-size="18" fill="#595c64">50</text><text x="1646.1" y="372" text-anchor="middle" class="mono" font-size="18" fill="#595c64">57</text>
    
    <text x="303" y="120" font-size="24" fill="#c52830" font-weight="600" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">front page</text>
    <text x="303" y="150" font-size="21" fill="#3f424a" paint-order="stroke" stroke="#f6f3ec" stroke-width="7" stroke-linejoin="round">the article is written</text>
    <text x="795" y="290" font-size="26" fill="#fff" font-weight="600" paint-order="stroke" stroke="#004d00" stroke-width="12" stroke-linejoin="round">every day: is it open? which detour? when?</text>
    <text x="70" y="408" class="mono" font-size="18" fill="#595c64">DAY</text>
  </svg>
  <div class="cols" style="margin-top:22px;gap:40px">
    <div style="display:flex;gap:22px;align-items:flex-start"><div style="width:30px;height:30px;background:#c52830;flex:none;margin-top:6px"></div><p class="body"><b style="color:#121317">5 days</b> the story leads. Each time, an article is written once, and starts to age.</p></div>
    <div style="display:flex;gap:22px;align-items:flex-start"><div style="width:30px;height:30px;background:#006600;flex:none;margin-top:6px"></div><p class="body"><b style="color:#121317">57 days</b> people need the current state. The answer changes; the article does not.</p></div>
