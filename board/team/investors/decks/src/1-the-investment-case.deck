"#121317" stroke-width="3"/><text x="163" y="172" text-anchor="middle" font-size="24" font-weight="600" fill="#121317">VoiceDebrief.ai</text><text x="163" y="144" text-anchor="middle" font-size="18" fill="#595c64">voice to transcript</text><circle cx="380" cy="320" r="100" fill="#006600"/><text x="380" y="316" text-anchor="middle" fill="#fff" font-size="32" font-weight="600" class="serif">PrompTugal</text><text x="380" y="350" text-anchor="middle" fill="#e2eedf" font-size="19">built from all of them</text>
