    <rect x="1020" y="190" width="200" height="120" fill="#121317"/><text x="1120" y="244" text-anchor="middle" fill="#f6f3ec" font-size="26" font-weight="600" class="serif">The gate</text><text x="1120" y="278" text-anchor="middle" fill="#c8c4ba" font-size="18">14 automatic checks</text>
