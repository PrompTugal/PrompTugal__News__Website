troke-width="1.5"/><text x="660" y="346" fill="#121317">security</text><line x1="894" y1="338" x2="1010" y2="250" stroke="#9d9580" stroke-width="2"/><line x1="520" y1="250" x2="640" y2="388" stroke="#9d9580" stroke-width="2"/><rect x="644" y="370" width="250" height="38" fill="#e2eedf" stroke="#006600" stroke-width="1.5"/><text x="660" y="396" fill="#121317">synthetic readers</text><line x1="894" y1="388" x2="1010" y2="250" stroke="#9d9580" stroke-width="2"/><line x1="520" y1="250" x2="640" y2="438" stroke="#9d9580" stroke-width="2"/><rect x="644" y="420" width="250" height="38" fill="#e2eedf" stroke="#006600" stroke-width="1.5"/><text x="660" y="446" fill="#121317">librarian</text><line x1="894" y1="438" x2="1010" y2="250" stroke="#9d9580" stroke-width="2"/><line x1="520" y1="250" x2="640" y2="488" stroke="#9d9580" stroke-width="2"/><rect x="644" y="470" width="250" height="38" fill="#e2eedf" stroke="#006600" stroke-width="1.5"/><text x="660" y="496" fill="#121317">accountant</text><line x1="894" y1="488" x2="1010" y2="250" stroke="#9d9580" stroke-width="2"/></g></g>
