 "findings": [
  {
   "id": "sw-g1",
   "kind": "gap",
   "text": "None of the five hosted European builders read (Infomaniak, saldiaBuild, IONOS, Jimdo, Hostinger) documents an export or move-out path on the pages read; Framer's terms describe none and only advise customers to archive their own content. This is the nearest rival evidence for our test 'you can move it'. Reading limited to the pages read: absence on a page is not proof of absence in the product.",
   "facts": [
    "sw-f005",
    "sw-f011",
    "sw-f017",
    "sw-f023",
    "sw-f028",
    "sw-f033"
   ]
  },
  {
   "id": "sw-g2",
   "kind": "overlap",
   "text": "Open-source static engines (Hugo, Jekyll, Eleventy, Astro, Zola) give the owner plain files and a permissive or open licence for free, but ask for a terminal and Node or Ruby; our offer is the same output made by agents for a non-technical owner.",
   "facts": [
    "sw-f036",
    "sw-f042",
    "sw-f045",
    "sw-f050"
   ]
  },
  {
   "id": "sw-g3",
   "kind": "gap",
   "text": "Open-source AI builders exist (bolt.diy, Dyad, tinykit, Totalum's AI App Builder Open) but all ask for developer setup and a model key of your own; one hosts the output itself (Totalum) and one keeps part of its code under a fair-source licence (Dyad). Nobody read offers an owner-ready, agent-built, movable small-business site.",
   "facts": [
    "sw-f066",
    "sw-f069",
    "sw-f076",
    "sw-f071"
   ]
  },
  {
   "id": "sw-g4",
   "kind": "claim-to-check",
   "text": "Hostinger's own privacy policy (via a search summary) says some servers are outside the EU and EEA and that AI Builder sites sit on a CDN with fixed location; yet it is listed as an EU builder in third-party roundups. Sovereignty claims in this ring are not uniform and need the buyer's own check.",
   "facts": [
    "sw-f027"
   ]
  },
  {
   "id": "sw-g5",
   "kind": "price-anchor",
   "text": "Hosted builders charge by subscription (examples read: Hostinger from $1.99 a month on a 48-month term renewing at $10.99; IONOS Starter $6 then $14 a month; Framer $10 to $30 a month; Ghost(Pro) $18 a month yearly). Our published line is one-off (500 anchor, 250 standing as relayed, 50 launch offer proposed): one-off against monthly is the difference to test, not a price comparison on its own.",
   "facts": [
    "sw-f025",
    "sw-f014",
    "sw-f029",
    "sw-f061"
   ]
  }
 ],
