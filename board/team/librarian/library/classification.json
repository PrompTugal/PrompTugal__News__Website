{
  "about": "PTC, the PrompTugal Classification (hand file, kept by librarian@PrompTugal.dinis). Ten classes with subclasses. The rules are read in order and the first match wins; an entry in overrides beats every rule. The call number is CLASS.SUB cutter, the cutter being the card's slug (library/build/lib/classify.mjs, cutter()). Two holdings with the same class, subclass and cutter get :2, :3 in order of accession. A rule needs at least one of: id, type, kind, section, path_exact, path_prefix, path_regex (all given conditions must hold). Optional special: S1 guidance, S2 founding record, S3 decisions, S4 errata.",
  "version": 1,
  "classes": {
    "GEN": { "name": "The repository", "subs": { "BOARD": "the board's front files", "BRIEF": "the brief and its pages", "MISC": "unclassified: the fallback, to be reviewed", "README": "readmes", "REALITY": "reality files", "RULES": "rules and instructions" } },
    "PUB": { "name": "The publication", "subs": { "ART": "articles", "BRAND": "brand and design", "FRONT": "the front page", "LIST": "list pages", "NEWS": "newsroom pages", "SITE": "site pages" } },
    "DAT": { "name": "Data and the ontology", "subs": { "CO": "companies", "EV": "events", "ONT": "the ontology", "ORG": "organisations", "PE": "people", "PL": "places", "SCH": "schemas", "TOP": "topics" } },
    "BLD": { "name": "Build, code and release", "subs": { "ASSET": "asset code", "CI": "continuous integration", "FEAT": "features", "GATE": "the gate", "TOOL": "tools" } },
    "TEAM": { "name": "Agents, roles, keys", "subs": { "ABP": "agent behaviour policies", "AGENT": "an agent", "BUDGET": "budgets", "INBOX": "inboxes", "KEY": "keys", "ROLE": "a role's own files", "RUN": "run reports", "SCHED": "schedules" } },
    "WRK": { "name": "Work in hand", "subs": { "BRIEF": "briefs", "DEC": "decisions", "DESK": "desks", "FIND": "findings of a pass", "PASS": "passes", "PLAN": "plans and specs", "STORY": "story projects", "TASK": "tasks" } },
    "GDN": { "name": "Guidance (special)", "subs": { "CONC": "concepts", "IDEA": "ideas", "MEMO": "memos", "Q": "open questions" } },
    "EVD": { "name": "Evidence and sources", "subs": { "CAP": "captures and snapshots", "SRC": "external sources", "VAULT": "vaults" } },
    "RDR": { "name": "Readers and observability", "subs": { "OBS": "observability", "SHERPA": "the reader's guide", "SYN": "synthetic readers" } },
    "LIB": { "name": "The library", "subs": { "AUTH": "authority files", "CAT": "catalogue and accession", "DESK": "the reference desk", "DOC": "the library's documents", "REAL": "the reality tree", "STOCK": "stocktake" } }
  },
  "rules": [
    { "id": "r-agent", "when": { "type": "agent" }, "class": "TEAM", "sub": "AGENT" },
    { "id": "r-idea", "when": { "type": "idea" }, "class": "GDN", "sub": "IDEA", "special": "S1" },
    { "id": "r-question", "when": { "type": "question" }, "class": "GDN", "sub": "Q", "special": "S1" },
    { "id": "r-concept", "when": { "type": "concept" }, "class": "GDN", "sub": "CONC" },
    { "id": "r-finding", "when": { "type": "finding" }, "class": "WRK", "sub": "FIND" },
    { "id": "r-pass", "when": { "type": "pass" }, "class": "WRK", "sub": "PASS" },
    { "id": "r-desk", "when": { "type": "desk" }, "class": "WRK", "sub": "DESK" },

    { "id": "r-lib-reality", "when": { "path_prefix": "board/team/librarian/library/reality/" }, "class": "LIB", "sub": "REAL" },
    { "id": "r-lib-authority", "when": { "path_prefix": "board/team/librarian/library/authority/" }, "class": "LIB", "sub": "AUTH" },
    { "id": "r-lib-desk", "when": { "path_prefix": "board/team/librarian/library/desk/" }, "class": "LIB", "sub": "DESK" },
    { "id": "r-lib-stocktake", "when": { "path_prefix": "board/team/librarian/library/stocktake/" }, "class": "LIB", "sub": "STOCK" },
    { "id": "r-lib-catalogue", "when": { "path_regex": "^board/team/librarian/(catalogue\\.mjs|jump\\.json|library/(catalogue/|cards\\.json|shelf-list|accession-register))" }, "class": "LIB", "sub": "CAT" },
    { "id": "r-lib-any", "when": { "path_prefix": "board/team/librarian/" }, "class": "LIB", "sub": "DOC" },

    { "id": "r-guidance", "when": { "path_prefix": "board/guidance/" }, "class": "GDN", "sub": "MEMO", "special": "S1" },
    { "id": "r-briefs", "when": { "path_prefix": "board/briefs/" }, "class": "WRK", "sub": "BRIEF" },
    { "id": "r-editor-briefs", "when": { "path_prefix": "board/editor-briefs/" }, "class": "WRK", "sub": "BRIEF" },
    { "id": "r-keys", "when": { "path_regex": "^board/(keys|person-keys)\\.json$" }, "class": "TEAM", "sub": "KEY" },
    { "id": "r-abp", "when": { "path_prefix": "board/abp/" }, "class": "TEAM", "sub": "ABP" },
    { "id": "r-inboxes", "when": { "path_regex": "^board/(inboxes/|inbox[^/]*\\.json$)" }, "class": "TEAM", "sub": "INBOX" },
    { "id": "r-schedule", "when": { "path_exact": "board/schedule.json" }, "class": "TEAM", "sub": "SCHED" },
    { "id": "r-budgets", "when": { "path_regex": "^board/(budgets\\.json|spec-budgets-schema\\.md)$" }, "class": "TEAM", "sub": "BUDGET" },
    { "id": "r-runs", "when": { "path_prefix": "board/runs/" }, "class": "TEAM", "sub": "RUN" },
    { "id": "r-snapshots", "when": { "path_exact": "board/snapshots.json" }, "class": "EVD", "sub": "CAP" },
    { "id": "r-tools", "when": { "path_prefix": "board/tools/" }, "class": "BLD", "sub": "TOOL" },
    { "id": "r-tasks", "when": { "path_prefix": "board/tasks/" }, "class": "WRK", "sub": "TASK" },
    { "id": "r-projects", "when": { "path_prefix": "board/projects/" }, "class": "WRK", "sub": "STORY" },
    { "id": "r-the-story", "when": { "path_regex": "^board/the-story-" }, "class": "WRK", "sub": "STORY" },
    { "id": "r-team-obs", "when": { "path_prefix": "board/team/observability/" }, "class": "RDR", "sub": "OBS" },
    { "id": "r-team-synthetic", "when": { "path_prefix": "board/team/synthetic/" }, "class": "RDR", "sub": "SYN" },
    { "id": "r-team-sherpa", "when": { "path_prefix": "board/team/sherpa/" }, "class": "RDR", "sub": "SHERPA" },
    { "id": "r-team", "when": { "path_prefix": "board/team/" }, "class": "TEAM", "sub": "ROLE" },
    { "id": "r-board-readme", "when": { "path_exact": "board/README.md" }, "class": "GEN", "sub": "README" },
    { "id": "r-board-plans", "when": { "path_regex": "^board/[^/]+\\.md$" }, "class": "WRK", "sub": "PLAN" },
    { "id": "r-board-any", "when": { "type": "board" }, "class": "GEN", "sub": "BOARD" },

    { "id": "r-p-article", "when": { "type": "page", "kind": "article" }, "class": "PUB", "sub": "ART" },
    { "id": "r-p-company", "when": { "type": "page", "kind": "company" }, "class": "DAT", "sub": "CO" },
    { "id": "r-p-event", "when": { "type": "page", "kind": "event" }, "class": "DAT", "sub": "EV" },
    { "id": "r-p-person", "when": { "type": "page", "kind": "person" }, "class": "DAT", "sub": "PE" },
    { "id": "r-p-organisation", "when": { "type": "page", "kind": "organisation" }, "class": "DAT", "sub": "ORG" },
    { "id": "r-p-place", "when": { "type": "page", "kind": "place" }, "class": "DAT", "sub": "PL" },
    { "id": "r-p-topic", "when": { "type": "page", "kind": "topic" }, "class": "DAT", "sub": "TOP" },
    { "id": "r-p-list", "when": { "type": "page", "kind": "list" }, "class": "PUB", "sub": "LIST" },
    { "id": "r-p-decision", "when": { "type": "page", "kind": "decision" }, "class": "WRK", "sub": "DEC", "special": "S3" },
    { "id": "r-p-newsroom", "when": { "type": "page", "kind": "newsroom" }, "class": "PUB", "sub": "NEWS" },
    { "id": "r-p-brief", "when": { "type": "page", "section": "brief" }, "class": "GEN", "sub": "BRIEF", "special": "S2" },
    { "id": "r-p-home", "when": { "type": "page", "section": "(home)" }, "class": "PUB", "sub": "FRONT" },
    { "id": "r-p-site", "when": { "type": "page" }, "class": "PUB", "sub": "SITE" }
  ],
  "overrides": {},
  "fallback": { "class": "GEN", "sub": "MISC" },
  "cutter": "the slug: the path's last part without its extension (the parent folder's name when that is index); the number of an idea, question or finding; the key id of an agent; the name of a desk or concept"
}
