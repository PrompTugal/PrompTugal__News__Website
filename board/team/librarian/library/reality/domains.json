 "fallback": "misc",
 "rules": [
  {
   "domain": "library",
   "id": "d-library",
   "when": {
    "call_prefix": "LIB."
   }
  },
  {
   "domain": "observability",
   "id": "d-observability",
   "when": {
    "call_prefix": "RDR.OBS"
   }
  },
  {
   "domain": "agents",
   "id": "d-team",
   "when": {
    "class": "TEAM"
   }
  },
  {
   "domain": "agents",
   "id": "d-readers",
   "when": {
    "class": "RDR"
   }
  },
  {
   "domain": "vaults-and-media",
   "id": "d-evidence",
   "when": {
    "class": "EVD"
   }
  },
  {
   "domain": "build-and-ci",
   "id": "d-build",
   "when": {
    "class": "BLD"
   }
  },
  {
   "domain": "process",
   "id": "d-work",
   "when": {
    "class": "WRK"
   }
  },
  {
   "domain": "process",
   "id": "d-guidance",
   "when": {
    "class": "GDN"
   }
  },
  {
   "domain": "publication",
   "id": "d-brief",
   "when": {
    "call_prefix": "GEN.BRIEF"
   }
  },
  {
   "domain": "process",
   "id": "d-gen",
   "when": {
    "class": "GEN"
   }
  },
  {
   "domain": "search",
   "id": "d-search",
   "when": {
    "path_regex": "^(search|ask)(/|\\.|$)"
   }
  },
  {
   "domain": "graphs",
   "id": "d-graphs",
   "when": {
    "path_regex": "^(graph|explorer|gravity|world|industry)(/|\\.|$)"
   }
  },
  {
   "domain": "data",
   "id": "d-schemas",
   "when": {
    "call_prefix": "DAT.SCH"
   }
  },
  {
   "domain": "data",
   "id": "d-ontology",
   "when": {
    "call_prefix": "DAT.ONT"
   }
  },
  {
   "domain": "pages",
   "id": "d-entities",
   "when": {
    "class": "DAT"
   }
  },
  {
   "domain": "newsroom",
   "id": "d-newsroom",
   "when": {
    "call_prefix": "PUB.NEWS"
   }
  },
  {
   "domain": "publication",
   "id": "d-articles",
   "when": {
    "call_prefix": "PUB.ART"
   }
  },
  {
   "domain": "publication",
   "id": "d-brand",
   "when": {
    "call_prefix": "PUB.BRAND"
   }
  },
  {
   "domain": "pages",
   "id": "d-pub",
   "when": {
    "class": "PUB"
   }
  }
 ]
